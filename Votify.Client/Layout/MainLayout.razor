@using System.Security.Claims
@inherits LayoutComponentBase
@inject Votify.Client.Services.IAuthService AuthService
@inject Votify.Client.Services.NotificacionesService NotificacionesService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="page">
    <main>
        <div class="brand-header">
            <!-- Spacer para centrar el logo en combinación con flex -->
            <div class="header-spacer"></div>

            <!-- Logo centrado -->
            <div class="logo-container">
                <a href="" @onclick:preventDefault @onclick="IrAInicio">
                    <div class="logo-icon">
                        <img src="images/votify-logo-blanco.png" alt="Votify Logo" />
                    </div>
                </a>
            </div>

            <!-- Controles de autenticación con el botón de ayuda arriba -->
            <div class="auth-controls">
                <div class="top-row">
                    @if (IsInHelpPage())
                    {
                        <button class="btn-ayuda btn-ayuda-active" disabled>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                                <line x1="12" y1="17" x2="12.01" y2="17"/>
                            </svg>
                            Ayuda
                        </button>
                    }
                    else
                    {
                        <a href="ayuda" class="btn-ayuda">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                                <line x1="12" y1="17" x2="12.01" y2="17"/>
                            </svg>
                            Ayuda
                        </a>
                    }
                    <AuthorizeView>
                        <Authorized>
                            <a href="notificaciones" class="btn-notificaciones" title="Notificaciones">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                                    </svg>
                                    @if (noLeidasCount > 0)
                                    {
                                        <span class="notif-badge">@noLeidasCount</span>
                                    }
                                </a>
                        </Authorized>
                    </AuthorizeView>
                </div>
                
                <div class="bottom-row">
                    <AuthorizeView>
                        <Authorized>
                            <div class="user-header-wrapper">
                                <div class="user-header-info">
                                    <div class="header-user-name">@GetUserName(context.User)</div>
                                    <div class="header-user-email">@GetUserEmail(context.User)</div>
                                </div>

                                <div class="user-menu-container" @onclick="ToggleUserMenu" @onfocusout="HideUserMenu" tabindex="0">
                                    <span class="user-greeting"><img src="images/usuario-logo.png" class="user-logo" alt="User Logo" /> ▼</span>

                                    @if (showUserMenu)
                                    {
                                        <div class="user-dropdown">
                                            <a class="dropdown-item text-danger" @onclick="CerrarSesion" @onclick:stopPropagation="true">
                                                Cerrar Sesión
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <a href="login" class="btn-login">Iniciar Sesión</a>
                            <a href="registro" class="btn-register">Registrarse</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool showUserMenu = false;
    private int noLeidasCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                  ?? authState.User.FindFirst("sub")?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            await CargarNoLeidasCount();
        }
    }

    private async Task CargarNoLeidasCount()
    {
        try
        {
            noLeidasCount = await NotificacionesService.ObtenerNoLeidasCountAsync();
        }
        catch { }
    }

    private bool IsInHelpPage()
    {
        return NavManager.Uri.EndsWith("/ayuda", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task HideUserMenu()
    {
        // Se le da tiempo a que el clic se ejecute antes de ocultar el menú
        await Task.Delay(150);

        showUserMenu = false;
        StateHasChanged();
    }

    private string GetUserName(ClaimsPrincipal user)
    {
        var nameClaim = user?.FindFirst(c => c.Type == ClaimTypes.Name || c.Type == ClaimTypes.NameIdentifier || c.Type == "unique_name");
        return nameClaim?.Value ?? user?.Identity?.Name ?? "Usuario";
    }

    private string GetUserEmail(ClaimsPrincipal user)
    {
        var emailClaim = user?.FindFirst(c => c.Type == ClaimTypes.Email || c.Type == "email");
        return emailClaim?.Value ?? string.Empty;
    }

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo(""); // Refresca la página al inicio
    }

    private void IrAInicio() => NavManager.NavigateTo("");
}
