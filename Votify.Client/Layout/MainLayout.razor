@inherits LayoutComponentBase
<div class="page">
    <main>
        <div class="brand-header">
            <div class="logo-container">
                <div class="logo-icon">
                    <img src="images/votify-logo.png" alt="Votify Logo" />
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
<style>
    .brand-header {
    display: flex;
    justify-content: center;
    padding: 1.5rem 0;
    margin-bottom: 0px;
}

.logo-container {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.logo-icon img {
    height: 80px;
    width: auto;
}

</style>
