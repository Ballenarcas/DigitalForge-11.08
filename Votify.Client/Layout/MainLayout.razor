@using System.Security.Claims
@using Votify.Client.Services
@inherits LayoutComponentBase
@inject Votify.Client.Services.IAuthService AuthService
@inject NavigationManager NavManager
@inject NotificationService NotificationService
@implements IDisposable

<div class="page">
    <main>
        <div class="brand-header">
            <!-- Spacer para centrar el logo en combinación con flex -->
            <div class="header-spacer"></div>

            <!-- Logo centrado -->
            <div class="logo-container">
                <a href="/">
                    <div class="logo-icon">
                        <img src="images/votify-logo-blanco.png" alt="Votify Logo" />
                    </div>
                </a>
            </div>

            <!-- Controles de autenticación con el botón de ayuda arriba -->
            <div class="auth-controls">
                <div class="top-row">
                    @if (IsInHelpPage())
                    {
                        <button class="btn-ayuda" disabled>Ayuda</button>
                    }
                    else
                    {
                        <a href="/ayuda" class="btn-ayuda">Ayuda</a>
                    }
                </div>
                
                <div class="bottom-row">
                    <AuthorizeView>
                        <Authorized>
                            <div class="user-header-wrapper">
                                <div class="user-header-info">
                                    <div class="header-user-name">@GetUserName(context.User)</div>
                                    <div class="header-user-email">@GetUserEmail(context.User)</div>
                                </div>

                                <!-- Campana de Notificaciones -->
                                <div class="notifications-container" @onclick="ToggleNotificationsMenu" @onfocusout="HideNotificationsMenu" tabindex="0">
                                    <button class="notifications-bell-btn" aria-label="Notificaciones">
                                        <span class="bell-icon">🔔</span>
                                        @if (unreadCount > 0)
                                        {
                                            <span class="notifications-badge">@unreadCount</span>
                                        }
                                    </button>

                                    @if (showNotificationsMenu)
                                    {
                                        <div class="notifications-dropdown" @onclick:stopPropagation="true">
                                            <div class="notifications-header">
                                                <span class="notifications-title">Notificaciones</span>
                                                <div class="notifications-actions">
                                                    @if (unreadCount > 0)
                                                    {
                                                        <button class="btn-action-text" @onclick="MarkNotificationsAsRead" @onclick:stopPropagation="true">Marcar leídas</button>
                                                    }
                                                    @if (notifications.Any())
                                                    {
                                                        <button class="btn-action-text text-danger" @onclick="ClearNotifications" @onclick:stopPropagation="true">Limpiar todo</button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="notifications-list">
                                                @if (!notifications.Any())
                                                {
                                                    <div class="notification-empty">No tienes notificaciones</div>
                                                }
                                                else
                                                {
                                                    @foreach (var n in notifications)
                                                    {
                                                        <div class="notification-item @(n.Leido ? "" : "unread")">
                                                            <div class="notification-indicator"></div>
                                                            <div class="notification-content">
                                                                <div class="notification-message">@n.Mensaje</div>
                                                                <div class="notification-meta">
                                                                    <span class="notification-tag @n.TipoEvento.ToLower()">@n.TipoEvento</span>
                                                                    <span class="notification-time">@FormatearFecha(n.Fecha)</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="user-menu-container" @onclick="ToggleUserMenu" @onfocusout="HideUserMenu" tabindex="0">
                                    <span class="user-greeting"><img src="images/usuario-logo.png" class="user-logo" alt="User Logo" /> ▼</span>

                                    @if (showUserMenu)
                                    {
                                        <div class="user-dropdown">
                                            <a class="dropdown-item text-danger" @onclick="CerrarSesion" @onclick:stopPropagation="true">
                                                Cerrar Sesión
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="btn-login">Iniciar Sesión</a>
                            <a href="/registro" class="btn-register">Registrarse</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool showUserMenu = false;
    private bool showNotificationsMenu = false;
    private List<NotificationClientDto> notifications = new();
    private readonly CancellationTokenSource _cts = new();

    private int unreadCount => notifications.Count(n => !n.Leido);

    protected override async Task OnInitializedAsync()
    {
        await CargarNotificaciones();

        // Bucle de sondeo (polling) cada 5 segundos
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            try
            {
                while (await timer.WaitForNextTickAsync(_cts.Token))
                {
                    await CargarNotificaciones();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                // Cancelado al destruir el componente
            }
        });
    }

    private async Task CargarNotificaciones()
    {
        notifications = await NotificationService.ObtenerNotificacionesAsync();
    }

    private void ToggleNotificationsMenu()
    {
        showNotificationsMenu = !showNotificationsMenu;
        if (showNotificationsMenu)
        {
            showUserMenu = false; // Cierra el menú de usuario
        }
    }

    private async Task HideNotificationsMenu()
    {
        await Task.Delay(150);
        showNotificationsMenu = false;
        StateHasChanged();
    }

    private async Task MarkNotificationsAsRead()
    {
        await NotificationService.MarcarComoLeidasAsync();
        await CargarNotificaciones();
    }

    private async Task ClearNotifications()
    {
        await NotificationService.LimpiarNotificacionesAsync();
        await CargarNotificaciones();
    }

    private string FormatearFecha(DateTime fecha)
    {
        var localTime = fecha.ToLocalTime();
        var diff = DateTime.Now - localTime;
        if (diff.TotalMinutes < 1) return "Ahora mismo";
        if (diff.TotalMinutes < 60) return $"Hace {Math.Floor(diff.TotalMinutes)}m";
        if (diff.TotalHours < 24) return $"Hace {Math.Floor(diff.TotalHours)}h";
        return localTime.ToString("dd/MM/yyyy HH:mm");
    }

    private bool IsInHelpPage()
    {
        return NavManager.Uri.EndsWith("/ayuda", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
        if (showUserMenu)
        {
            showNotificationsMenu = false; // Cierra el menú de notificaciones
        }
    }

    private async Task HideUserMenu()
    {
        await Task.Delay(150);
        showUserMenu = false;
        StateHasChanged();
    }

    private string GetUserName(ClaimsPrincipal user)
    {
        var nameClaim = user?.FindFirst(c => c.Type == ClaimTypes.Name || c.Type == ClaimTypes.NameIdentifier || c.Type == "unique_name");
        return nameClaim?.Value ?? user?.Identity?.Name ?? "Usuario";
    }

    private string GetUserEmail(ClaimsPrincipal user)
    {
        var emailClaim = user?.FindFirst(c => c.Type == ClaimTypes.Email || c.Type == "email");
        return emailClaim?.Value ?? string.Empty;
    }

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/", true);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
