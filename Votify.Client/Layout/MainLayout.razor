@inherits LayoutComponentBase
@inject Votify.Client.Services.IAuthService AuthService
@inject NavigationManager NavManager

<div class="page">
    <main>
        <div class="brand-header">
            <div class="header-spacer"></div>

            <div class="logo-container">
                <a href="/">
                    <div class="logo-icon">
                        <img src="images/votify-logo.png" alt="Votify Logo" />
                    </div>
                </a>
            </div>

            <div class="auth-controls">
                <AuthorizeView>
                    <Authorized>
                        <div class="user-menu-container" @onclick="ToggleUserMenu" @onfocusout="HideUserMenu" tabindex="0">
                            <span class="user-greeting">👤 @context.User.Identity?.Name ▼</span>
                            
                            @if (showUserMenu)
                            {
                                <div class="user-dropdown">
                                    <button class="dropdown-item text-danger" @onclick="CerrarSesion" @onclick:stopPropagation="true">
                                        🚪 Cerrar Sesión
                                    </button>
                                </div>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn-login">Iniciar Sesión</a>
                        <a href="/registro" class="btn-register">Registrarse</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool showUserMenu = false;

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task HideUserMenu()
    {
        // Se le da tiempo a que el clic se ejecute antes de ocultar el menú
        await Task.Delay(150);

        showUserMenu = false;
        StateHasChanged();
    }

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/", true); // Refresca la página al inicio
    }
}
