@using System.Security.Claims
@inherits LayoutComponentBase
@inject Votify.Client.Services.IAuthService AuthService
@inject NavigationManager NavManager

<div class="page">
    <main>
        <div class="brand-header">
            <div class="header-spacer"></div>

            <div class="logo-container">
                <a href="/">
                    <div class="logo-icon">
                        <img src="images/votify-logo-blanco.png" alt="Votify Logo" />
                    </div>
                </a>
            </div>

            <div class="auth-controls">
                <AuthorizeView>
                    <Authorized>
                        <div class="user-header-wrapper">
                            <div class="user-header-info">
                                <div class="header-user-name">@GetUserName(context.User)</div>
                                <div class="header-user-email">@GetUserEmail(context.User)</div>
                            </div>

                            <div class="user-menu-container" @onclick="ToggleUserMenu" @onfocusout="HideUserMenu" tabindex="0">
                                <span class="user-greeting"><img src="images/usuario-logo.png" class="user-logo" alt="User Logo" /> ▼</span>

                                @if (showUserMenu)
                                {
                                    <div class="user-dropdown">
                                        <button class="dropdown-item text-danger" @onclick="CerrarSesion" @onclick:stopPropagation="true">
                                            🚪 Cerrar Sesión
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn-login">Iniciar Sesión</a>
                        <a href="/registro" class="btn-register">Registrarse</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool showUserMenu = false;

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task HideUserMenu()
    {
        // Se le da tiempo a que el clic se ejecute antes de ocultar el menú
        await Task.Delay(150);

        showUserMenu = false;
        StateHasChanged();
    }

    private string GetUserName(ClaimsPrincipal user)
    {
        var nameClaim = user?.FindFirst(c => c.Type == ClaimTypes.Name || c.Type == ClaimTypes.NameIdentifier || c.Type == "unique_name");
        return nameClaim?.Value ?? user?.Identity?.Name ?? "Usuario";
    }

    private string GetUserEmail(ClaimsPrincipal user)
    {
        var emailClaim = user?.FindFirst(c => c.Type == ClaimTypes.Email || c.Type == "email");
        return emailClaim?.Value ?? string.Empty;
    }

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/", true); // Refresca la página al inicio
    }
}
