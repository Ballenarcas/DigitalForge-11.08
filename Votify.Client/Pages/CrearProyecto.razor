@page "/{VotacionId}/nuevo-proyecto"
@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Votify.Client.DTOs
@using Votify.Client.Services
@inject ProyectosService ProyectosService
@inject VotacionesService VotacionesService
@inject EventosService EventosService
@inject EquiposService EquiposService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="main-container">
    <div class="top-nav">
        <button class="btn-back" @onclick="HandleVolver">
            <span class="icon-arrow">←</span> Volver
        </button>
        <div class="breadcrumbs">
            <a href="/" class="breadcrumb-link">Eventos</a> <span class="separator">></span>
            <a href="/votaciones" class="breadcrumb-link">Votaciones</a> <span class="separator">></span>
            <span class="current-page">Subir Proyecto</span>
        </div>
    </div>

    <div class="card">
        <h2 class="title">Subir Nuevo Proyecto</h2>
        <p class="subtitle">Si eres competidor, el proyecto se asigna a tu equipo automáticamente. Si eres organizador, puedes elegir el equipo manualmente.</p>

        @if (cargando)
        {
            <div class="loading-state">
                <div class="spinner-shell"></div>
                <p>Cargando información del evento...</p>
            </div>
        }
        else
        {
            <div class="form-body">
                <div class="form-group">
                    <label>Nombre del proyecto <span class="required-asterisk">*</span></label>
                    <input type="text" class="form-control" @bind="Nombre" placeholder="Ej: Votify - Sistema de votaciones" />
                </div>

                <div class="form-group">
                    <label>Descripción <span class="required-asterisk">*</span></label>
                    <textarea class="form-control textarea-custom" @bind="Descripcion" placeholder="Explica de qué trata tu proyecto..." rows="3"></textarea>
                </div>

                <div class="form-group">
                    <label>Equipo</label>

                    @if (EsOrganizador)
                    {
                        <select class="form-control" @bind="EquipoSeleccionadoId">
                            <option value="">Selecciona un equipo</option>
                            @foreach (var equipo in EquiposDisponibles)
                            {
                                <option value="@equipo.Id.ToString()">@equipo.Nombre</option>
                            }
                        </select>
                        <small class="helper-text">El proyecto quedará asignado al equipo que elijas.</small>
                    }
                    else
                    {
                        <input type="text" class="form-control" value="@EquipoAuto" readonly />
                        <small class="helper-text">Se usa automáticamente el equipo al que perteneces.</small>
                    }
                </div>

                <div class="form-group">
                    <label>Imagen del proyecto</label>
                    <div class="upload-container">
                        @if (!string.IsNullOrEmpty(ImagenUrl))
                        {
                            <div class="preview-container">
                                <img src="@ImagenUrl" class="image-preview" />
                                <button class="btn-remove-image" @onclick="() => ImagenUrl = null">Eliminar</button>
                            </div>
                        }
                        else
                        {
                            <div class="upload-box">
                                <InputFile OnChange="HandleFileSelected" id="fileInput" class="hidden-input" accept="image/*" />
                                <label for="fileInput" class="upload-label">
                                    <span class="upload-icon">📷</span>
                                    <span class="upload-text">Seleccionar imagen</span>
                                    <span class="upload-subtext">PNG, JPG o WEBP</span>
                                </label>
                            </div>
                        }
                    </div>
                    @if (subiendoImagen)
                    {
                        <p class="uploading-text">Subiendo imagen...</p>
                    }
                </div>

                <button class="btn-submit" @onclick="HandleCrearProyecto" disabled="@(subiendoImagen || creando || !PuedeCrearProyecto)">
                    @if (creando)
                    {
                        <span class="spinner-small"></span>
                    }
                    Subir Proyecto
                </button>

                @if (!string.IsNullOrEmpty(Mensaje))
                {
                    var isInfo = Mensaje.Contains("Nota:");
                    var isError = Mensaje.Contains("Error");
                    var alertClass = isError ? "alert-error" : (isInfo ? "alert-info" : "alert-success");
                    var icon = isError ? "❌" : (isInfo ? "ℹ️" : "✅");
                    
                    <div class="alert @alertClass">
                        <span>@icon</span>
                        <span>@Mensaje</span>
                    </div>
                }
            </div>

            <em class="required-footer">
                <span>*</span> Campos obligatorios
            </em>
        }
    </div>
</div>

<style>
.main-container {
    background-color: #f8f9fc;
    min-height: 100vh;
    padding: 2rem;
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

.top-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
}

.btn-back {
    background: white;
    border: 1px solid #e2e8f0;
    padding: 0.6rem 1.2rem;
    border-radius: 12px;
    color: #621d95;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s;
}

.btn-back:hover { background: #f1f5f9; }

.breadcrumbs { color: #94a3b8; font-size: 0.9rem; }
.current-page { color: #621d95; font-weight: 700; }

.card {
    background: white;
    max-width: 750px;
    margin: 0 auto;
    border-radius: 45px;
    padding: 3.5rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02);
}

.title {
    font-size: 2rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 0.5rem;
    letter-spacing: -0.025em;
}

.subtitle { color: #64748b; margin-bottom: 2.5rem; font-size: 1.1rem; }
.required-asterisk { color: #dc2626; font-weight: 800; font-size: 1.2rem; }

.form-group { margin-bottom: 1.5rem; }
.form-group label {
    display: flex;
    font-weight: 700;
    color: #334155;
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
    align-items: center;
    gap: 0.3rem;
}

.form-control {
    width: 100%;
    padding: 0.9rem 1.2rem;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    font-size: 1rem;
    color: #1e293b;
    background-color: #ffffff;
    transition: all 0.2s;
    box-sizing: border-box;
}

.form-control:focus {
    outline: none;
    border-color: #621d95;
    box-shadow: 0 0 0 3px rgba(98, 29, 149, 0.1);
}

.textarea-custom { resize: none; font-family: inherit; }
.helper-text { display: block; margin-top: 0.45rem; color: #64748b; font-size: 0.82rem; }

.loading-state { padding: 2rem 0 0.5rem; text-align: center; color: #64748b; }
.spinner-shell {
    width: 36px;
    height: 36px;
    border: 4px solid #f3e8ff;
    border-top: 4px solid #9333ea;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
    margin: 0 auto 1rem auto;
}

.upload-box {
    border: 2px dashed #e2e8f0;
    border-radius: 20px;
    padding: 2rem;
    text-align: center;
    transition: 0.2s;
    cursor: pointer;
}
.upload-box:hover { border-color: #621d95; background: #fdfaff; }
.hidden-input { display: none; }
.upload-label { cursor: pointer; display: flex; flex-direction: column; align-items: center; }
.upload-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
.upload-text { font-weight: 700; color: #1e293b; }
.upload-subtext { font-size: 0.8rem; color: #94a3b8; }

.preview-container {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 200px;
    border: 1px solid #e2e8f0;
}
.image-preview { width: 100%; height: 100%; object-fit: cover; }
.btn-remove-image {
    position: absolute;
    top: 10px; right: 10px;
    background: rgba(239, 68, 68, 0.9);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
}

.btn-submit {
    width: 100%;
    background: linear-gradient(to right, #a855f7, #9333ea);
    color: white;
    border: none;
    padding: 1.2rem;
    border-radius: 20px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 1.5rem;
    transition: transform 0.1s, opacity 0.2s;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
}
.btn-submit:hover:not(:disabled) { opacity: 0.9; }
.btn-submit:active:not(:disabled) { transform: scale(0.99); }
.btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

.alert {
    padding: 1rem;
    border-radius: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
}
.alert-success { background-color: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
.alert-error { background-color: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
.alert-info { background-color: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }

.spinner-small {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top: 2px solid white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.required-footer { font-size: 0.85rem; color: #64748b; font-style: italic; display: block; margin-top: 1rem; }
.required-footer span { color: #dc2626; font-weight: 800; }

@@media (max-width: 768px) {
    .main-container { padding: 1rem; }
    .card { padding: 1.5rem; border-radius: 28px; }
    .top-nav { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
}
</style>

@code {
    [Parameter] public string? VotacionId { get; set; }

    string Nombre = string.Empty;
    string Descripcion = string.Empty;
    string? ImagenUrl;
    string? Mensaje;
    string? EventoId;
    string? RolEvento;
    string? ParticipanteId;
    string? EquipoSeleccionadoId;
    string EquipoAuto = string.Empty;
    bool subiendoImagen = false;
    bool creando = false;
    bool cargando = true;
    bool yaTieneProyecto = false;

    List<EquipoDto> EquiposDisponibles = new();

    private bool EsOrganizador => string.Equals(RolEvento?.Trim(), "ORGANIZADOR", StringComparison.OrdinalIgnoreCase)
        || string.Equals(RolEvento?.Trim(), "Organizador", StringComparison.OrdinalIgnoreCase);

    private bool PuedeCrearProyecto => !yaTieneProyecto && (EsOrganizador ? !string.IsNullOrWhiteSpace(EquipoSeleccionadoId) : !string.IsNullOrWhiteSpace(EquipoAuto));

    protected override async Task OnInitializedAsync()
    {
        await CargarContextoAsync();
    }

    private async Task CargarContextoAsync()
    {
        cargando = true;
        try
        {
            ParticipanteId = await ObtenerMiParticipanteIdAsync();

            if (string.IsNullOrWhiteSpace(VotacionId))
            {
                Mensaje = "Error: No se encontró la votación.";
                return;
            }

            var votacion = await VotacionesService.ObtenerVotacion(VotacionId);
            if (votacion == null)
            {
                Mensaje = "Error: No se pudo cargar la votación asociada.";
                return;
            }

            EventoId = votacion.EventoId;
            RolEvento = await EventosService.ObtenerRolEnEvento(EventoId);

            if (string.IsNullOrWhiteSpace(ParticipanteId) || !Guid.TryParse(ParticipanteId, out var participanteGuid))
            {
                Mensaje = "Error: No se pudo identificar al usuario autenticado.";
                return;
            }

            if (!EsOrganizador)
            {
                var equipo = await EquiposService.ObtenerEquipoDeParticipanteAsync(participanteGuid);
                if (equipo == null)
                {
                    Mensaje = "Error: Debes pertenecer a un equipo para crear un proyecto.";
                    return;
                }

                EquipoAuto = equipo.Nombre;
                EquipoSeleccionadoId = equipo.Id.ToString();
                
                // Comprobar si el equipo ya tiene un proyecto en esta votación
                var proyectos = await ProyectosService.ObtenerProyectosAsync(VotacionId);
                yaTieneProyecto = proyectos.Any(p => p.Equipo_Id == EquipoSeleccionadoId);
                if (yaTieneProyecto)
                {
                    Mensaje = "Nota: Tu equipo ya tiene un proyecto en esta votación.";
                }
            }
            else
            {
                EquiposDisponibles = await EquiposService.ObtenerEquiposAsync();
                EquipoSeleccionadoId = EquiposDisponibles.FirstOrDefault()?.Id.ToString();
            }
        }
        catch (Exception ex)
        {
            Mensaje = "Error al cargar el formulario: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task<string?> ObtenerMiParticipanteIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        return user.FindFirst(ClaimTypes.NameIdentifier)?.Value
               ?? user.FindFirst("sub")?.Value
               ?? user.FindFirst("nameid")?.Value;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            subiendoImagen = true;
            StateHasChanged();

            var file = e.File;
            if (file != null)
            {
                var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                content.Add(fileContent, "file", file.Name);

                ImagenUrl = await ProyectosService.SubirImagen(content);
            }
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            if (msg.Contains("\"Error\""))
                msg = System.Text.RegularExpressions.Regex.Match(msg, "\"Error\":\"(.*?)\"").Groups[1].Value;
            Mensaje = "Error al subir la imagen: " + (string.IsNullOrEmpty(msg) ? ex.Message : msg);
        }
        finally
        {
            subiendoImagen = false;
            StateHasChanged();
        }
    }

    async Task HandleCrearProyecto()
    {
        if (string.IsNullOrWhiteSpace(Nombre) || string.IsNullOrWhiteSpace(Descripcion))
        {
            Mensaje = "Error: El nombre y la descripción son obligatorios.";
            return;
        }

        if (string.IsNullOrWhiteSpace(VotacionId) || !Guid.TryParse(VotacionId, out var votacionGuid))
        {
            Mensaje = "Error: La votación no es válida.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ParticipanteId) || !Guid.TryParse(ParticipanteId, out var participanteGuid))
        {
            Mensaje = "Error: No se pudo identificar al usuario autenticado.";
            return;
        }

        if (!EsOrganizador && string.IsNullOrWhiteSpace(EquipoAuto))
        {
            Mensaje = "Error: Debes pertenecer a un equipo para crear un proyecto.";
            return;
        }

        if (EsOrganizador && string.IsNullOrWhiteSpace(EquipoSeleccionadoId))
        {
            Mensaje = "Error: Debes seleccionar un equipo.";
            return;
        }

        try
        {
            creando = true;
            Mensaje = null;
            StateHasChanged();

            var dto = new ProyectoDto
            {
                Id = string.Empty,
                Nombre = Nombre,
                Descripcion = Descripcion,
                Equipo_Id = EquipoSeleccionadoId,
                VotacionId = votacionGuid,
                ImagenUrl = ImagenUrl,
                ParticipanteId = participanteGuid
            };

            await ProyectosService.CrearProyectoAsync(dto);
            Mensaje = "Proyecto subido correctamente.";

            StateHasChanged();
            await Task.Delay(1000);
            Nav.NavigateTo($"/{VotacionId}/proyectos/");
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            if (msg.Contains("\"Error\""))
                msg = System.Text.RegularExpressions.Regex.Match(msg, "\"Error\":\"(.*?)\"").Groups[1].Value;
            Mensaje = "Error al subir el proyecto: " + (string.IsNullOrEmpty(msg) ? ex.Message : msg);
        }
        finally
        {
            creando = false;
            StateHasChanged();
        }
    }

    private void HandleVolver() => Nav.NavigateTo($"/{VotacionId}/proyectos/");
}