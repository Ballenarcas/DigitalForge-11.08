@page "/registro"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="icon-container">
            ✨
        </div>
        <h1 class="title">Crea una cuenta</h1>
        <p class="subtitle">Únete a Votify y participa en los eventos</p>

        <EditForm Model="registroModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }

            <div class="form-group">
                <label>Nombre Completo</label>
                <InputText @bind-Value="registroModel.Nombre" class="form-control" placeholder="Juan Pérez" />
            </div>

            <div class="form-group">
                <label>Correo Electrónico</label>
                <InputText @bind-Value="registroModel.Email" class="form-control" placeholder="ejemplo@correo.com" />
            </div>

            <div class="grid-2-cols">
                <div class="form-group">
                    <label>Contraseña</label>
                    <InputText @bind-Value="registroModel.Password" type="password" class="form-control" placeholder="••••••••" />
                </div>

                <div class="form-group">
                    <label>Confirmar Contraseña</label>
                    <InputText @bind-Value="registroModel.ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                </div>
            </div>

            <button type="submit" class="btn-primary-custom" disabled="@isLoading">
                @if(isLoading) { <span>Registrando...</span> } else { <span>Registrarse</span> }
            </button>
        </EditForm>

        <div class="divider">
            <span>¿Ya tienes una cuenta?</span>
        </div>

        <div class="footer-link">
            <a href="/login">Inicia sesión aquí</a>
        </div>
    </div>
</div>

<style>
    .auth-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .auth-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        width: 100%;
        max-width: 480px;
        text-align: center;
        animation: card-fade-in 0.6s ease-out;
    }

    @keyframes card-fade-in {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .icon-container {
        font-size: 40px;
        margin-bottom: 10px;
        animation: icon-pop 0.5s ease-out 0.2s both;
    }

    @keyframes icon-pop {
        from { transform: scale(0.5); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .title {
        font-size: 24px;
        font-weight: 800;
        color: #1a202c;
        margin-bottom: 5px;
        animation: fade-in-up 0.5s ease-out 0.3s both;
    }

    .subtitle {
        color: #718096;
        font-size: 14px;
        margin-bottom: 30px;
        animation: fade-in-up 0.5s ease-out 0.4s both;
    }

    @keyframes fade-in-up {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-group {
        text-align: left;
        margin-bottom: 20px;
        animation: fade-in-up 0.4s ease-out both;
    }

    .form-group:nth-of-type(1) { animation-delay: 0.5s; }
    .form-group:nth-of-type(2) { animation-delay: 0.6s; }

    .grid-2-cols {
        display: flex;
        gap: 15px;
        animation: fade-in-up 0.4s ease-out 0.7s both;
    }

    .grid-2-cols .form-group {
        flex: 1;
        animation: none;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #2d3748;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-sizing: border-box;
        font-size: 14px;
        transition: all 0.3s ease;
        background: white;
    }

    .form-control:focus {
        outline: none;
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
    }

    .form-control:hover:not(:focus) {
        border-color: #cbd5e1;
    }

    .footer-link a {
        color: #8b5cf6;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: color 0.2s;
    }

    .footer-link a:hover {
        color: #7c3aed;
        text-decoration: underline;
    }

    .btn-primary-custom {
        width: 100%;
        padding: 14px;
        background-color: #8b5cf6;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.25s ease;
        margin-top: 10px;
        animation: fade-in-up 0.4s ease-out 0.8s both;
    }

    .btn-primary-custom:hover:not(:disabled) {
        background-color: #7c3aed;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3);
    }

    .btn-primary-custom:active:not(:disabled) {
        transform: translateY(0) scale(0.98);
    }
    
    .btn-primary-custom:disabled {
        background-color: #c4b5fd;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 30px 0;
        color: #a0aec0;
        font-size: 14px;
        animation: fade-in 0.4s ease-out 0.9s both;
    }

    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .divider::before, .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #e2e8f0;
    }

    .divider span {
        padding: 0 10px;
    }

    .footer-link {
        animation: fade-in 0.4s ease-out 1.0s both;
    }

    .error-message {
        background-color: #fed7d7;
        color: #c53030;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        animation: error-shake 0.4s ease-in-out;
    }

    @keyframes error-shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        50% { transform: translateX(6px); }
        75% { transform: translateX(-3px); }
    }
</style>

@code {
    public class RegisterViewModel
    {
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private RegisterViewModel registroModel = new RegisterViewModel();
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(registroModel.Nombre) || string.IsNullOrWhiteSpace(registroModel.Email) || string.IsNullOrWhiteSpace(registroModel.Password))
        {
             errorMessage = "Por favor, completa todos los campos obligatorios.";
             return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(registroModel.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            errorMessage = "El formato del correo electrónico no es válido.";
            return;
        }

        if (registroModel.Password != registroModel.ConfirmPassword)
        {
            errorMessage = "Las contraseñas no coinciden.";
            return;
        }

        isLoading = true;

        var dto = new Votify.Application.DTOs.RegisterRequestDto 
        { 
            Nombre = registroModel.Nombre, 
            Email = registroModel.Email, 
            Password = registroModel.Password 
        };

        var response = await AuthService.RegisterAsync(dto);

        if (response.IsSuccess)
        {
            var loginDto = new Votify.Application.DTOs.LoginRequestDto { Email = dto.Email, Password = dto.Password };
            await AuthService.LoginAsync(loginDto);
            NavigationManager.NavigateTo("/");
        }
        else
        {
             errorMessage = response.Message;
        }

        isLoading = false;
    }
}
