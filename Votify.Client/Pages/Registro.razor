@page "/registro"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="auth-epic-wrapper">
    <!-- Orbes de luz flotantes -->
    <div class="auth-orb orb-1"></div>
    <div class="auth-orb orb-2"></div>
    <div class="auth-orb orb-3"></div>

    <!-- Particulas sutiles -->
    @for (int i = 0; i < 20; i++)
    {
        var left = (i * 5.3) % 100;
        var duration = 10 + (i % 8);
        var delay = i * 0.4;
        var size = 2 + (i % 3);
        <div class="auth-particle" style="left:@(left)%; width:@(size)px; height:@(size)px; animation-duration:@(duration)s; animation-delay:@(delay)s;"></div>
    }

    <div class="auth-epic-card">
        <div class="auth-icon">
            <svg viewBox="0 0 24 24" fill="none" width="32" xmlns="http://www.w3.org/2000/svg">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="8.5" cy="7" r="4" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="20" y1="8" x2="20" y2="14" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="23" y1="11" x2="17" y2="11" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <h1 class="auth-title">Crea una cuenta</h1>
        <p class="auth-subtitle">Únete a Votify y participa en los eventos</p>

        <EditForm Model="registroModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-error">@errorMessage</div>
            }

            <div class="auth-form-group">
                <label>Nombre Completo</label>
                <InputText @bind-Value="registroModel.Nombre" class="auth-input" placeholder="Juan Pérez" />
            </div>

            <div class="auth-form-group">
                <label>Correo Electrónico</label>
                <InputText @bind-Value="registroModel.Email" class="auth-input" placeholder="ejemplo@correo.com" />
            </div>

            <div class="auth-grid-2">
                <div class="auth-form-group">
                    <label>Contraseña</label>
                    <InputText @bind-Value="registroModel.Password" type="password" class="auth-input" placeholder="••••••••" />
                </div>

                <div class="auth-form-group">
                    <label>Confirmar</label>
                    <InputText @bind-Value="registroModel.ConfirmPassword" type="password" class="auth-input" placeholder="••••••••" />
                </div>
            </div>

            <button type="submit" class="auth-btn-primary" disabled="@isLoading">
                @if(isLoading)
                {
                    <span class="btn-spinner"></span>
                    <span>Registrando...</span>
                }
                else
                {
                    <span>Registrarse</span>
                }
            </button>
        </EditForm>

        <div class="auth-divider">
            <span>¿Ya tienes una cuenta?</span>
        </div>

        <div class="auth-footer">
            <a href="/login">Inicia sesión aquí</a>
        </div>
    </div>
</div>

<style>
    /* Reset local */
    :scope { all: initial; }
</style>

@code {
    public class RegisterViewModel
    {
        public string Nombre { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private RegisterViewModel registroModel = new RegisterViewModel();
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(registroModel.Nombre) || string.IsNullOrWhiteSpace(registroModel.Email) || string.IsNullOrWhiteSpace(registroModel.Password))
        {
             errorMessage = "Por favor, completa todos los campos obligatorios.";
             return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(registroModel.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            errorMessage = "El formato del correo electrónico no es válido.";
            return;
        }

        if (registroModel.Password != registroModel.ConfirmPassword)
        {
            errorMessage = "Las contraseñas no coinciden.";
            return;
        }

        isLoading = true;

        var dto = new Votify.Application.DTOs.RegisterRequestDto 
        { 
            Nombre = registroModel.Nombre, 
            Email = registroModel.Email, 
            Password = registroModel.Password 
        };

        var response = await AuthService.RegisterAsync(dto);

        if (response.IsSuccess)
        {
            var loginDto = new Votify.Application.DTOs.LoginRequestDto { Email = dto.Email, Password = dto.Password };
            await AuthService.LoginAsync(loginDto);
            NavigationManager.NavigateTo("/");
        }
        else
        {
             errorMessage = response.Message;
        }

        isLoading = false;
    }
}
