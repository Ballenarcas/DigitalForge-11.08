@page "/evento/{EventoId:guid}/roles"
@using System.Linq
@using Votify.Client.DTOs
@inject Votify.Client.Services.EventosService EventosService
@inject NavigationManager Nav
@inject Votify.Client.Services.AppState AppState
@inject AuthenticationStateProvider AuthStateProvider

<div class="roles-container">
    <!-- Header Section -->
    <div class="roles-header">
        <div>
            <span class="roles-breadcrumb-badge">VOTACIÓN ABIERTA</span>
            <h1 class="roles-page-title">Gestión de Roles del Evento</h1>
            <p class="roles-page-description">Administra los permisos y categorías de los miembros del equipo y participantes asignados a este evento.</p>
        </div>
        <button class="btn roles-invite-btn" @onclick="VolverAlaVotaciones">
            <span class="roles-invite-icon">←</span> Volver
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="roles-message @(IsErrorMessage ? "roles-message-error" : "roles-message-success")">
            @StatusMessage
        </div>
    }

    <!-- Users Section -->
    <div class="roles-users-card">
        <div class="roles-users-header">
            <div>
                <h3 class="roles-users-title">Usuarios Registrados</h3>
            </div>
            <div class="roles-search-container">
                <svg class="roles-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text" class="roles-search-input" placeholder="Buscar por nombre o correo..."
                       @oninput="HandleSearch"
                       value="@SearchTerm" />
            </div>
        </div>

        @if (!isAuthorized)
        {
            <div class="roles-empty">No tienes permisos</div>
        }
        else if (isLoading)
        {
            <div class="roles-loading">Cargando participantes...</div>
        }
        else if (!Participantes.Any())
        {
            <div class="roles-empty">No hay participantes registrados para este evento.</div>
        }
        else
        {
            <div class="roles-table-wrapper">
                <table class="roles-users-table">
                    <thead>
                        <tr>
                            <th class="roles-col-user">NOMBRE Y USUARIO</th>
                            <th class="roles-col-email">CORREO ELECTRÓNICO</th>
                            <th class="roles-col-role">ROL ASIGNADO</th>
                            <th class="roles-col-actions">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in PageParticipantes)
                        {
                            <tr class="roles-table-row">
                                <td class="roles-col-user">
                                    <div class="roles-user-cell">
                                        <div class="roles-user-avatar">@GetInitials(user.Nombre)</div>
                                        <div class="roles-user-info">
                                            <div class="roles-user-name">@user.Nombre</div>
                                            <div class="roles-user-handle">@user.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="roles-col-email">@user.Email</td>
                                <td class="roles-col-role">
                                    <select class="roles-role-dropdown" disabled="@IsCurrentUser(user)" title="@(IsCurrentUser(user) ? "No puedes cambiar tu propio rol" : "Cambiar rol")" @onchange="async e => await UpdateRole(user, e.Value?.ToString() ?? user.Rol)">
                                        @foreach (var rol in RolesDisponibles)
                                        {
                                            <option value="@rol" selected="@(user.Rol == rol)">@rol</option>
                                        }
                                    </select>
                                    @if (IsCurrentUser(user))
                                    {
                                        <div class="roles-inline-warning">No puedes cambiar tu propio rol</div>
                                    }
                                </td>
                                <td class="roles-col-actions">
                                    <button class="roles-action-btn" disabled="@IsCurrentUser(user)" title="@(IsCurrentUser(user) ? "No puedes cambiar tu propio rol" : "Quitar participante")" @onclick="() => QuitarParticipante(user)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2z"></path>
                                            <polyline points="10 11 10 17 14 11 14 17"></polyline>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="roles-pagination-wrapper">
                <span class="roles-pagination-info">Mostrando @PageFrom a @PageTo de @Participantes.Count usuarios</span>
                <nav class="roles-pagination">
                    <button class="roles-page-btn @(CurrentPage == 1 ? "disabled" : "")" @onclick="PreviousPage">‹</button>
                    @for (var page = 1; page <= TotalPages; page++)
                    {
                        var currentPageValue = page;
                        <button class="roles-page-btn @(currentPageValue == CurrentPage ? "active" : "")" @onclick="() => GoToPage(currentPageValue)">@currentPageValue</button>
                    }
                    <button class="roles-page-btn @(CurrentPage == TotalPages ? "disabled" : "")" @onclick="NextPage">›</button>
                </nav>
            </div>
        }
    </div>

    <!-- Stats Section -->
    <div class="roles-stats-grid">
        <div class="roles-stat-card roles-stat-primary">
            <div class="roles-stat-icon">✓</div>
            <div class="roles-stat-content">
                <div class="roles-stat-value">@Stats.Organizadores</div>
                <div class="roles-stat-label">ORGANIZADORES</div>
            </div>
        </div>
        <div class="roles-stat-card roles-stat-primary">
            <div class="roles-stat-icon">⚖</div>
            <div class="roles-stat-content">
                <div class="roles-stat-value">@Stats.Jurados</div>
                <div class="roles-stat-label">MIEMBROS DEL JURADO</div>
            </div>
        </div>
        <div class="roles-stat-card roles-stat-primary">
            <div class="roles-stat-icon">C</div>
            <div class="roles-stat-content">
                <div class="roles-stat-value">@Stats.Competidores</div>
                <div class="roles-stat-label">COMPETIDORES</div>
            </div>
        </div>
        <div class="roles-stat-card roles-stat-accent">
            <div class="roles-stat-icon">P</div>
            <div class="roles-stat-content">
                <div class="roles-stat-value">@Stats.Publicos</div>
                <div class="roles-stat-label">PÚBLICO</div>
            </div>
        </div>
    </div>
</div>

<style>
