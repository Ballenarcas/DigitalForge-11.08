</style>

@code {
    [Parameter] public Guid EventoId { get; set; }

    private string EventName = string.Empty;
    private string SearchTerm = string.Empty;
    private int CurrentPage = 1;
    private int PageSize = 10;
    private bool isLoading = true;
    private bool isAuthorized = true;
    private string? CurrentUserId;
    private string StatusMessage = string.Empty;
    private bool IsErrorMessage = false;

    private readonly string[] RolesDisponibles = new[] { "ORGANIZADOR", "JURADO", "COMPETIDOR", "PÚBLICO" };

    private List<ParticipanteRolDto> Participantes { get; set; } = new();
    private RoleStatisticsDto Stats { get; set; } = new();

    private IEnumerable<ParticipanteRolDto> PageParticipantes => Participantes
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Participantes.Count / (double)PageSize));
    private int PageFrom => Participantes.Count == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int PageTo => Math.Min(Participantes.Count, CurrentPage * PageSize);

    protected override async Task OnInitializedAsync()
    {
        if (EventoId == Guid.Empty)
        {
            return;
        }

        AppState.EventoId = EventoId.ToString();
        await LoadEventInfo();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        CurrentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                        ?? authState.User.FindFirst("sub")?.Value
                        ?? authState.User.FindFirst("nameid")?.Value;

        var rol = await EventosService.ObtenerRolEnEvento(EventoId.ToString());
        isAuthorized = EsOrganizador(rol);
        if (!isAuthorized)
        {
            ShowError("No tienes permisos");
            isLoading = false;
            return;
        }

        await LoadParticipantesAsync();
    }

    private async Task LoadEventInfo()
    {
        var evento = await EventosService.ObtenerEvento(EventoId.ToString());
        if (evento != null)
        {
            EventName = evento.Nombre;
            AppState.EventoNombre = evento.Nombre;
        }
    }

    private async Task LoadParticipantesAsync()
    {
        isLoading = true;
        try
        {
            Participantes = await EventosService.ObtenerParticipantesPorEvento(EventoId.ToString(), SearchTerm);
            Stats = await EventosService.ObtenerEstadisticasRoles(EventoId.ToString());
            CurrentPage = 1;
        }
        catch (Exception ex)
        {
            Participantes = new List<ParticipanteRolDto>();
            Stats = new RoleStatisticsDto();
            isAuthorized = false;
            ShowError(ex.Message.Contains("No tienes permisos", StringComparison.OrdinalIgnoreCase) ? "No tienes permisos" : ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadParticipantesAsync();
    }

    private async Task UpdateRole(ParticipanteRolDto user, string newRole)
    {
        if (string.IsNullOrWhiteSpace(newRole) || user.Rol == newRole)
        {
            return;
        }

        if (IsCurrentUser(user))
        {
            ShowError("No puedes cambiar tu propio rol");
            return;
        }

        var previousRole = user.Rol;
        try
        {
            user.Rol = newRole;
            await EventosService.CambiarRolParticipante(EventoId.ToString(), user.Id, newRole);
            Stats = await EventosService.ObtenerEstadisticasRoles(EventoId.ToString());
            ShowSuccess(string.IsNullOrWhiteSpace(previousRole) ? "Rol asignado correctamente" : "Rol cambiado exitosamente");
        }
        catch (Exception ex)
        {
            user.Rol = previousRole;
            ShowError(ex.Message);
        }
    }

    private async Task QuitarParticipante(ParticipanteRolDto user)
    {
        if (IsCurrentUser(user))
        {
            ShowError("No puedes cambiar tu propio rol");
            return;
        }

        try
        {
            await EventosService.EliminarParticipanteDeEvento(EventoId.ToString(), user.Id);
            ShowSuccess("Participante quitado correctamente");
            await LoadParticipantesAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private void VolverAlaVotaciones()
    {
        Nav.NavigateTo($"/votaciones?eventoId={EventoId}&eventoNombre={Uri.EscapeDataString(EventName)}");
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }

    private void GoToPage(int page)
    {
        CurrentPage = page;
    }

    private string GetInitials(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
        {
            return "?";
        }

        var parts = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0].Length >= 2 ? parts[0][..2].ToUpper() : parts[0].ToUpper();
        }

        return string.Concat(parts[0][0], parts[^1][0]).ToUpper();
    }

    private bool IsCurrentUser(ParticipanteRolDto user)
    {
        return !string.IsNullOrWhiteSpace(CurrentUserId)
            && string.Equals(user.Id, CurrentUserId, StringComparison.OrdinalIgnoreCase);
    }

    private static bool EsOrganizador(string? rol)
    {
        return string.Equals(rol?.Trim(), "ORGANIZADOR", StringComparison.OrdinalIgnoreCase)
            || string.Equals(rol?.Trim(), "Organizador", StringComparison.OrdinalIgnoreCase);
    }

    private void ShowError(string message)
    {
        StatusMessage = string.IsNullOrWhiteSpace(message) ? "No tienes permisos" : message;
        IsErrorMessage = true;
    }

    private void ShowSuccess(string message)
    {
        StatusMessage = message;
        IsErrorMessage = false;
    }
}
