@page "/evento/{EventoId:guid}/roles"
@using System.Linq
@using Votify.Client.DTOs
@inject Votify.Client.Services.EventosService EventosService
@inject NavigationManager Nav
@inject Votify.Client.Services.AppState AppState
@inject AuthenticationStateProvider AuthStateProvider

<div class="roles-container">
    <!-- Back button + Title -->
    <div class="roles-top-nav">
        <button class="btn-volver" @onclick="VolverAlaVotaciones">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                <path d="M15 19L8 12L15 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Votaciones
        </button>
    </div>

    <div class="roles-title-row">
        <img src="images/logo-cambio-votacion.png" alt="Gestión de Roles" style="width:20px;height:20px;" />
        <span class="brand-name">Gestión de Roles — @EventName</span>
    </div>
    <p class="roles-page-description" style="max-width:1000px; margin: -1rem auto 1.5rem; color:#64748b; font-size:0.9rem;">Administra los permisos y categorías de los miembros del equipo y participantes asignados a este evento.</p>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="roles-message @(IsErrorMessage ? "roles-message-error" : "roles-message-success")">
            @StatusMessage
        </div>
    }

    <!-- Users Section -->
    <div class="roles-users-card">
        <div class="roles-users-header">
            <div>
                <h3 class="roles-users-title">Usuarios Registrados</h3>
            </div>
            <div class="roles-search-container">
                <svg class="roles-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text" class="roles-search-input" placeholder="Buscar por nombre o correo..."
                       @oninput="HandleSearch"
                       value="@SearchTerm" />
            </div>
        </div>

        @if (!isAuthorized)
        {
            <div class="roles-empty">No tienes permisos</div>
        }
        else if (isLoading)
        {
            <div class="roles-loading">Cargando participantes...</div>
        }
        else if (!Participantes.Any())
        {
            <div class="roles-empty">No hay participantes registrados para este evento.</div>
        }
        else
        {
            <div class="roles-table-wrapper">
                <table class="roles-users-table">
                    <thead>
                        <tr>
                            <th class="roles-col-user">NOMBRE Y USUARIO</th>
                            <th class="roles-col-email">CORREO ELECTRÓNICO</th>
                            <th class="roles-col-role">ROL ASIGNADO</th>
                            <th class="roles-col-actions">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in PageParticipantes)
                        {
                            <tr class="roles-table-row">
                                <td class="roles-col-user">
                                    <div class="roles-user-cell">
                                        <div class="roles-user-avatar">@GetInitials(user.Nombre)</div>
                                        <div class="roles-user-info">
                                            <div class="roles-user-name">@user.Nombre</div>
                                            <div class="roles-user-handle">@user.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="roles-col-email">@user.Email</td>
                                <td class="roles-col-role">
                                    <select class="roles-role-dropdown" disabled="@IsCurrentUser(user)" title="@(IsCurrentUser(user) ? "No puedes cambiar tu propio rol" : "Cambiar rol")" @onchange="async e => await UpdateRole(user, e.Value?.ToString() ?? user.Rol)">
                                        @foreach (var rol in RolesDisponibles)
                                        {
                                            <option value="@rol" selected="@(user.Rol == rol)">@rol</option>
                                        }
                                    </select>
                                    @if (IsCurrentUser(user))
                                    {
                                        <div class="roles-inline-warning">No puedes cambiar tu propio rol</div>
                                    }
                                </td>
                                <td class="roles-col-actions">
                                    <button class="roles-action-btn" disabled="@IsCurrentUser(user)" title="@(IsCurrentUser(user) ? "No puedes cambiar tu propio rol" : "Quitar participante")" @onclick="() => QuitarParticipante(user)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2z"></path>
                                            <polyline points="10 11 10 17 14 11 14 17"></polyline>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="roles-pagination-wrapper">
                <span class="roles-pagination-info">Mostrando @PageFrom a @PageTo de @Participantes.Count usuarios</span>
                <nav class="roles-pagination">
                    <button class="roles-page-btn @(CurrentPage == 1 ? "disabled" : "")" @onclick="PreviousPage">‹</button>
                    @for (var page = 1; page <= TotalPages; page++)
                    {
                        var currentPageValue = page;
                        <button class="roles-page-btn @(currentPageValue == CurrentPage ? "active" : "")" @onclick="() => GoToPage(currentPageValue)">@currentPageValue</button>
                    }
                    <button class="roles-page-btn @(CurrentPage == TotalPages ? "disabled" : "")" @onclick="NextPage">›</button>
                </nav>
            </div>
        }
    </div>

    <!-- Stats Section -->
    <div class="roles-stats-grid">
        <div class="roles-stat-card roles-stat-primary">
            <div class="roles-stat-icon">✓</div>
            <div class="roles-stat-content">
                <div class="roles-stat-value">@Stats.Organizadores</div>
                <div class="roles-stat-label">ORGANIZADORES</div>
            </div>
        </div>
        <div class="roles-stat-card roles-stat-primary">
            <div class="roles-stat-icon">⚖</div>
            <div class="roles-stat-content">
                <div class="roles-stat-value">@Stats.Jurados</div>
                <div class="roles-stat-label">MIEMBROS DEL JURADO</div>
            </div>
        </div>
        <div class="roles-stat-card roles-stat-primary">
            <div class="roles-stat-icon">C</div>
            <div class="roles-stat-content">
                <div class="roles-stat-value">@Stats.Competidores</div>
                <div class="roles-stat-label">COMPETIDORES</div>
            </div>
        </div>
        <div class="roles-stat-card roles-stat-accent">
            <div class="roles-stat-icon">P</div>
            <div class="roles-stat-content">
                <div class="roles-stat-value">@Stats.Publicos</div>
                <div class="roles-stat-label">PÚBLICO</div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #a855f7;
        --primary-dark: #7c3aed;
        --primary-darkest: #4c1d95;
        --primary-light: #faf9ff;
        --text-primary: #1a1a1a;
        --text-secondary: #64748b;
        --border-light: #e2e8f0;
        --surface-white: #ffffff;
        --surface-bg: #f5f5f7;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
        --shadow-md: 0 8px 16px rgba(0, 0, 0, 0.08);
    }

    .roles-container {
        background: var(--surface-bg);
        min-height: 100vh;
        padding: 2rem 2rem;
        font-family: 'Inter', sans-serif;
        position: relative;
    }

    .roles-container::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--primary), transparent);
        opacity: 0.3;
        pointer-events: none;
    }

    .roles-top-nav {
        display: flex;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto 1.5rem;
    }

    .btn-volver {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--surface-white);
        border: 1px solid var(--border-light);
        color: var(--text-secondary);
        padding: 0.65rem 1.25rem;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.9rem;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .btn-volver::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: rgba(168, 85, 247, 0.1);
        transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: -1;
    }

    .btn-volver:hover {
        border-color: var(--primary);
        color: var(--primary);
    }

    .btn-volver:hover::before {
        left: 0;
    }

    .btn-volver svg {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-volver:hover svg {
        transform: translateX(-2px);
    }

    .roles-title-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
        animation: fadeInDown 0.6s ease-out 0.1s both;
    }

    .brand-name {
        font-weight: 800;
        font-size: 1.2rem;
        color: var(--primary-darkest);
        letter-spacing: -0.02em;
    }

    .roles-page-description {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin: 0 auto 2rem;
        line-height: 1.6;
        max-width: 1200px;
        font-weight: 300;
        animation: fadeInUp 0.6s ease-out 0.2s both;
    }

    .roles-message {
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 500;
        margin-bottom: 1.5rem;
        padding: 1rem 1.5rem;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
        border-left: 4px solid;
        animation: slideDown 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .roles-message-error {
        background: #fef2f2;
        border-left-color: #dc2626;
        color: #991b1b;
    }

    .roles-message-success {
        background: #ecfdf5;
        border-left-color: #16a34a;
        color: #047857;
    }

    .roles-users-card {
        background: var(--surface-white);
        border-radius: 20px;
        padding: 2.5rem;
        margin: 0 auto 2.5rem;
        max-width: 1200px;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-light);
        animation: fadeInUp 0.6s ease-out 0.3s both;
    }

    .roles-users-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border-light);
    }

    .roles-users-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .roles-search-container {
        position: relative;
        width: 100%;
        max-width: 320px;
    }

    .roles-search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        color: var(--text-secondary);
        pointer-events: none;
        opacity: 0.6;
    }

    .roles-search-input {
        width: 100%;
        padding: 0.85rem 1rem 0.85rem 3rem;
        border: 1px solid var(--border-light);
        border-radius: 10px;
        font-size: 0.95rem;
        background: #f9f9fb;
        font-family: 'Inter', sans-serif;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        color: var(--text-primary);
    }

    .roles-search-input::placeholder {
        color: var(--text-secondary);
        opacity: 0.6;
    }

    .roles-search-input:focus {
        outline: none;
        border-color: var(--primary);
        background: var(--surface-white);
        box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.1);
        color: var(--text-primary);
    }

    .roles-table-wrapper {
        overflow-x: auto;
    }

    .roles-users-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1.5rem;
    }

    .roles-users-table thead {
        border-bottom: 1px solid var(--border-light);
    }

    .roles-users-table th {
        padding: 1rem 0;
        text-align: left;
        font-size: 0.75rem;
        font-weight: 600;
        color: #999;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-family: 'Inter', sans-serif;
    }

    .roles-table-row {
        border-bottom: 1px solid #f0f0f2;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .roles-table-row:hover {
        background: #fafbfc;
    }

    .roles-users-table td {
        padding: 1.2rem 0;
        vertical-align: middle;
        color: var(--text-primary);
    }

    .roles-col-user {
        width: 35%;
    }

    .roles-col-email {
        width: 25%;
    }

    .roles-col-role {
        width: 25%;
    }

    .roles-col-actions {
        width: 15%;
        text-align: right;
    }

    .roles-user-cell {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .roles-user-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
        flex-shrink: 0;
        box-shadow: 0 2px 6px rgba(168, 85, 247, 0.2);
        font-family: 'Inter', sans-serif;
    }

    .roles-user-info {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .roles-user-name {
        font-weight: 500;
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    .roles-user-handle {
        font-size: 0.85rem;
        color: #999;
    }

    .roles-role-dropdown {
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-light);
        border-radius: 8px;
        background: white;
        color: var(--primary);
        font-weight: 600;
        font-size: 0.9rem;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .roles-role-dropdown:hover:not(:disabled) {
        border-color: var(--primary);
        background: var(--primary-light);
        box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.1);
    }

    .roles-role-dropdown:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.1);
    }

    .roles-role-dropdown:disabled,
    .roles-action-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .roles-inline-warning {
        margin-top: 0.35rem;
        color: #b45309;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .roles-action-btn {
        width: 36px;
        height: 36px;
        border-radius: 999px;
        border: 1px solid var(--border-light);
        background: white;
        color: #999;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .roles-action-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--primary-light);
        opacity: 0;
        transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: -1;
    }

    .roles-action-btn:hover:not(:disabled) {
        border-color: var(--primary);
        color: var(--primary);
        background: var(--primary-light);
    }

    .roles-action-btn:active:not(:disabled)::before {
        opacity: 0.1;
    }

    .roles-action-btn svg {
        width: 18px;
        height: 18px;
    }

    .roles-pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f0f0f2;
    }

    .roles-pagination-info {
        font-size: 0.85rem;
        color: #999;
    }

    .roles-pagination {
        display: flex;
        gap: 0.5rem;
    }

    .roles-page-btn {
        width: 36px;
        height: 36px;
        border: 1px solid var(--border-light);
        background: white;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 500;
        color: #666;
        font-family: 'Inter', sans-serif;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .roles-page-btn:hover:not(.disabled):not(.active) {
        border-color: var(--primary);
        color: var(--primary);
    }

    .roles-page-btn.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        box-shadow: 0 4px 12px rgba(168, 85, 247, 0.15);
    }

    .roles-page-btn.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .roles-loading,
    .roles-empty {
        padding: 3rem 2rem;
        text-align: center;
        color: #999;
        font-size: 1rem;
    }

    .roles-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        max-width: 1200px;
        margin: 2rem auto 0;
    }

    .roles-stat-card {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.8rem;
        border-radius: 20px;
        background: white;
        border: 1px solid #f0f0f2;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        animation: fadeInUp 0.6s ease-out both;
    }

    .roles-stat-card:hover {
        border-color: var(--primary);
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(168, 85, 247, 0.1);
    }

    .roles-stat-card:nth-child(1) {
        animation-delay: 0.4s;
    }

    .roles-stat-card:nth-child(2) {
        animation-delay: 0.5s;
    }

    .roles-stat-card:nth-child(3) {
        animation-delay: 0.6s;
    }

    .roles-stat-card:nth-child(4) {
        animation-delay: 0.7s;
    }

    .roles-stat-primary {
        background: white;
        border: 1px solid #f0f0f2;
    }

    .roles-stat-accent {
        background: linear-gradient(135deg, var(--primary), #9333ea);
        border: none;
    }

    .roles-stat-icon {
        font-size: 2rem;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(168, 85, 247, 0.1);
        flex-shrink: 0;
        border: 1px solid rgba(168, 85, 247, 0.15);
    }

    .roles-stat-accent .roles-stat-icon {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .roles-stat-content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .roles-stat-value {
        font-size: 2rem;
        font-weight: 800;
        color: #1a1a1a;
    }

    .roles-stat-accent .roles-stat-value {
        color: white;
    }

    .roles-stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #999;
    }

    .roles-stat-accent .roles-stat-label {
        color: rgba(255, 255, 255, 0.75);
    }

    .roles-pagination-info {
        font-size: 0.85rem;
        color: var(--text-secondary);
        font-weight: 500;
    }

    .roles-pagination {
        display: flex;
        gap: 0.5rem;
    }

    .roles-page-btn {
        width: 40px;
        height: 40px;
        border: 1px solid var(--border-light);
        background: var(--surface-white);
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        color: var(--text-secondary);
        font-family: 'Outfit', sans-serif;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .roles-page-btn:hover:not(.disabled):not(.active) {
        border-color: var(--accent-gold);
        color: var(--accent-gold);
        background: var(--accent-gold-light);
    }

    .roles-page-btn.active {
        background: var(--primary-dark);
        color: white;
        border-color: var(--primary-dark);
        box-shadow: 0 4px 12px rgba(45, 55, 72, 0.15);
    }

    .roles-page-btn.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .roles-loading,
    .roles-empty {
        padding: 4rem 2rem;
        text-align: center;
        color: var(--text-secondary);
        font-size: 1rem;
        font-weight: 300;
    }

    .roles-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        max-width: 1200px;
        margin: 2rem auto 0;
    }

    .roles-stat-card {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem;
        border-radius: 12px;
        background: var(--surface-white);
        border: 1px solid var(--border-light);
        box-shadow: var(--shadow-sm);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        animation: fadeInUp 0.6s ease-out both;
    }

    .roles-stat-card:hover {
        border-color: var(--accent-gold);
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(212, 165, 116, 0.1);
    }

    .roles-stat-card:nth-child(1) {
        animation-delay: 0.4s;
    }

    .roles-stat-card:nth-child(2) {
        animation-delay: 0.5s;
    }

    .roles-stat-card:nth-child(3) {
        animation-delay: 0.6s;
    }

    .roles-stat-card:nth-child(4) {
        animation-delay: 0.7s;
    }

