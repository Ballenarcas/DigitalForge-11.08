</style>

@code {
    [SupplyParameterFromQuery(Name = "eventoId")]
    public string? EventoId { get; set; }

    private string NombreEquipo { get; set; } = string.Empty;
    private string Mensaje { get; set; } = string.Empty;
    private string? MiParticipanteId { get; set; }
    private string? MiRolEvento { get; set; }
    private string? EquipoSeleccionadoId { get; set; }
    private string? ParticipanteSeleccionadoId { get; set; }
    private EquipoDto? MiEquipoActual { get; set; }
    private bool cargando = true;
    private bool creandoEquipo = false;
    private bool agregandoParticipante = false;

    private List<EquipoDto> EquiposDisponibles { get; set; } = new();
    private List<ParticipanteDto> ParticipantesRegistrados { get; set; } = new();

    private bool EsOrganizador => string.Equals(MiRolEvento?.Trim(), "ORGANIZADOR", StringComparison.OrdinalIgnoreCase)
        || string.Equals(MiRolEvento?.Trim(), "Organizador", StringComparison.OrdinalIgnoreCase);

    private EquipoDto? EquipoSeleccionado
    {
        get
        {
            if (Guid.TryParse(EquipoSeleccionadoId, out var equipoId))
            {
                return EquiposDisponibles.FirstOrDefault(e => e.Id == equipoId);
            }

            return MiEquipoActual;
        }
    }

    private IEnumerable<ParticipanteDto> ParticipantesDisponibles
    {
        get
        {
            var equipoId = EquipoSeleccionado?.Id;

            return ParticipantesRegistrados
                .Where(p => p.Id.ToString() != MiParticipanteId)
                .Where(p => equipoId == null || p.EquipoId != equipoId)
                .OrderBy(p => p.Nombre)
                .ToList();
        }
    }

    private bool PuedeGestionarEquipos => EsOrganizador || MiEquipoActual != null;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadoAsync();
    }

    private async Task CargarEstadoAsync()
    {
        cargando = true;
        try
        {
            MiParticipanteId = await ObtenerMiParticipanteIdAsync();

            if (!string.IsNullOrWhiteSpace(EventoId))
            {
                MiRolEvento = await EventosService.ObtenerRolEnEvento(EventoId);
            }

            EquiposDisponibles = await EquiposService.ObtenerEquiposAsync();
            ParticipantesRegistrados = await ParticipantesService.ObtenerParticipantesAsync();

            if (Guid.TryParse(MiParticipanteId, out var participanteId))
            {
                MiEquipoActual = await EquiposService.ObtenerEquipoDeParticipanteAsync(participanteId);
            }

            InicializarEquipoSeleccionado();
        }
        catch (Exception ex)
        {
            Mensaje = $"Error al cargar la pantalla: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void InicializarEquipoSeleccionado()
    {
        if (MiEquipoActual != null)
        {
            EquipoSeleccionadoId = MiEquipoActual.Id.ToString();
            return;
        }

        if (EsOrganizador && EquiposDisponibles.Any())
        {
            EquipoSeleccionadoId = EquiposDisponibles.First().Id.ToString();
        }
    }

    private async Task<string?> ObtenerMiParticipanteIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

         return user.FindFirst(ClaimTypes.NameIdentifier)?.Value
             ?? user.FindFirst("sub")?.Value
             ?? user.FindFirst("nameid")?.Value;
    }

    private void HandleVolver()
    {
        if (!string.IsNullOrEmpty(EventoId))
        {
            Nav.NavigateTo($"/votaciones?eventoId={EventoId}");
        }
        else
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task HandleCrearEquipo()
    {
        if (string.IsNullOrWhiteSpace(NombreEquipo))
        {
            Mensaje = "Error: El nombre del equipo es obligatorio.";
            return;
        }

        creandoEquipo = true;
        Mensaje = string.Empty;

        try
        {
            var equipo = await EquiposService.CrearEquipoAsync(NombreEquipo.Trim());
            if (equipo == null)
            {
                Mensaje = "Error al crear el equipo. Inténtelo de nuevo.";
                return;
            }

            if (!EquiposDisponibles.Any(e => e.Id == equipo.Id))
            {
                EquiposDisponibles.Add(equipo);
            }

            NombreEquipo = string.Empty;
            EquipoSeleccionadoId = equipo.Id.ToString();
            MiEquipoActual = MiEquipoActual ?? equipo;
            Mensaje = "Equipo creado correctamente.";
        }
        catch (Exception ex)
        {
            Mensaje = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            creandoEquipo = false;
        }
    }

    private async Task HandleAgregarParticipante()
    {
        if (!Guid.TryParse(EventoId, out var eventoGuid))
        {
            Mensaje = "Error: No se encontró el evento asociado al equipo.";
            return;
        }

        if (!Guid.TryParse(EquipoSeleccionadoId, out var equipoGuid))
        {
            Mensaje = "Error: Debes seleccionar un equipo válido.";
            return;
        }

        if (!Guid.TryParse(ParticipanteSeleccionadoId, out var participanteGuid))
        {
            Mensaje = "Error: Debes seleccionar un participante válido.";
            return;
        }

        agregandoParticipante = true;
        Mensaje = string.Empty;

        try
        {
            var agregado = await EquiposService.AsignarParticipanteAsync(equipoGuid, participanteGuid, eventoGuid);
            if (!agregado)
            {
                Mensaje = "Error al agregar el participante al equipo.";
                return;
            }

            ParticipanteSeleccionadoId = string.Empty;
            ParticipantesRegistrados = await ParticipantesService.ObtenerParticipantesAsync();
            if (Guid.TryParse(MiParticipanteId, out var miId))
            {
                MiEquipoActual = await EquiposService.ObtenerEquipoDeParticipanteAsync(miId);
            }

            Mensaje = "Participante agregado correctamente y marcado como competidor del evento.";
        }
        catch (Exception ex)
        {
            Mensaje = ex.Message.Contains("Error") ? ex.Message : $"Error al agregar el participante: {ex.Message}";
        }
        finally
        {
            agregandoParticipante = false;
        }
    }
}