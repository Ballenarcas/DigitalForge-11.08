@page "/nuevo-equipo"
@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Votify.Client.DTOs
@using Votify.Client.Services
@inject EquiposService EquiposService
@inject EventosService EventosService
@inject ParticipantesService ParticipantesService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="main-container">
    <div class="top-nav">
        <button class="btn-back" @onclick="HandleVolver">
            <span class="icon-arrow">←</span> Volver
        </button>
        <div class="breadcrumbs">
            <span class="breadcrumb-link" @onclick="HandleVolver" style="cursor:pointer;">Votaciones</span> <span class="separator">></span> <span class="current-page">Equipos</span>
        </div>
    </div>

    @if (cargando)
    {
        <div class="loading-shell">
            <div class="spinner"></div>
            <p>Cargando equipos...</p>
        </div>
    }
    else
    {
        <div class="content-stack">
            <div class="card">
                <h2 class="title">Crear Nuevo Equipo</h2>
                <p class="subtitle">Registra un nuevo equipo para el evento y luego añade los participantes que correspondan.</p>

                <div class="form-body">
                    <div class="form-group">
                        <label>Nombre del Equipo <span class="required-asterisk">*</span></label>
                        <input type="text" class="form-control" @bind="NombreEquipo" placeholder="Ej: Los Innovadores" />
                    </div>

                    <button class="btn-submit" @onclick="HandleCrearEquipo" disabled="@creandoEquipo">
                        @if (creandoEquipo)
                        {
                            <span class="spinner-small"></span>
                        }
                        Crear Equipo
                    </button>

                    @if (!string.IsNullOrEmpty(Mensaje))
                    {
                        <div class="alert @(Mensaje.Contains("Error") ? "alert-error" : "alert-success")">
                            <span>@(Mensaje.Contains("Error") ? "❌" : "✅")</span>
                            <span>@Mensaje</span>
                        </div>
                    }
                </div>

                <em>
                    <span>*</span> Campos obligatorios
                </em>
            </div>

            <div class="card team-manager-card">
                <div class="section-header">
                    <div>
                        <h2 class="title">Añadir participantes</h2>
                        <p class="subtitle">Los organizadores pueden gestionar cualquier equipo; los miembros solo el suyo.</p>
                    </div>
                </div>

                @if (!PuedeGestionarEquipos)
                {
                    <div class="empty-state">
                        <strong>No hay equipo disponible para gestionar.</strong>
                        <p>Debes pertenecer a un equipo o ser organizador del evento para añadir participantes.</p>
                    </div>
                }
                else
                {
                    @if (EsOrganizador && EquiposDisponibles.Any())
                    {
                        <div class="form-group">
                            <label>Equipo a gestionar</label>
                            <select class="form-control" @bind="EquipoSeleccionadoId">
                                @foreach (var equipo in EquiposDisponibles)
                                {
                                    <option value="@equipo.Id.ToString()">@equipo.Nombre</option>
                                }
                            </select>
                        </div>
                    }
                    else if (EquipoSeleccionado != null)
                    {
                        <div class="team-chip-row">
                            <span class="team-chip">@EquipoSeleccionado.Nombre</span>
                            <span class="team-chip-muted">Tu equipo actual</span>
                        </div>
                    }

                    @if (EquipoSeleccionado == null)
                    {
                        <div class="empty-state compact">
                            <strong>Selecciona o crea un equipo.</strong>
                            <p>Cuando haya un equipo activo podrás agregar participantes aquí mismo.</p>
                        </div>
                    }
                    else
                    {
                        <div class="team-summary">
                            <div>
                                <span class="summary-label">Equipo activo</span>
                                <h3>@EquipoSeleccionado.Nombre</h3>
                            </div>
                            <div class="summary-badge">@ParticipantesDisponibles.Count() participante(s) disponible(s)</div>
                        </div>

                        <div class="form-group">
                            <label>Participante a agregar <span class="required-asterisk">*</span></label>
                            <select class="form-control" @bind="ParticipanteSeleccionadoId">
                                <option value="">Selecciona un participante</option>
                                @foreach (var participante in ParticipantesDisponibles)
                                {
                                    <option value="@participante.Id.ToString()">@participante.Nombre (@participante.Email)</option>
                                }
                            </select>
                        </div>

                        <button class="btn-submit team-action-btn" @onclick="HandleAgregarParticipante" disabled="@(agregandoParticipante || string.IsNullOrWhiteSpace(ParticipanteSeleccionadoId))">
                            @if (agregandoParticipante)
                            {
                                <span class="spinner-small"></span>
                            }
                            Agregar participante
                        </button>
                    }
                }
            </div>
        </div>
    }
</div>

<style>
