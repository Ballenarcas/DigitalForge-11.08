@page "/{VotacionId}/proyectos/{ProyectoId}"
@using Votify.Client.DTOs
@using Votify.Client.Services
@inject ProyectosService ProyectosService
@inject VotacionesService VotacionesService
@inject NavigationManager Nav

<div class="detalles-wrapper">
    @if (cargando)
    {
        <div class="loader-center">
            <div class="spinner"></div>
            <p>Cargando proyecto...</p>
        </div>
    }
    else if (proyecto == null)
    {
        <div class="error-state">
            <p>No se pudo cargar el proyecto.</p>
        </div>
    }
    else
    {
        <div class="detalles-layout">

            <!-- breadcrumb dentro del layout -->
            <div class="header-principal">
                <button class="btn-volver" @onclick="Volver">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                        <path d="M15 19L8 12L15 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Proyectos
                </button>
            </div>

            <div class="page-header-row">
                <div class="logo-icon small">
                    <img src="images/proyectos-logo.png" alt="Logo" class="evento-logo-img" style="width:20px;height:20px;" />
                </div>
                <span class="brand-name">Detalles de "@(proyecto?.Nombre ?? "...")"</span>
            </div>


            @if (limiteAlcanzado && !votoOk)
            {
                <div class="alert-limite alert-top">
                    <svg viewBox="0 0 24 24" fill="none" width="20" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 8v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <span>Has alcanzado el límite de votos para esta votación. No puedes votar por más proyectos.</span>
                </div>
            }

            @if (votacion != null && votacion.Estado == 1)
            {
                <div class="alert-pausada alert-top">
                    <svg viewBox="0 0 24 24" fill="none" width="20" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M9 9h2v6H9zM13 9h2v6h-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <span>Esta votación está <strong>PAUSADA</strong>. No puedes emitir votos en este momento.</span>
                </div>
            }

            @if (votacion != null && votacion.Estado == 2)
            {
                <div class="alert-finalizada alert-top">
                    <svg viewBox="0 0 24 24" fill="none" width="20" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M8 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <span>Esta votación ha <strong>FINALIZADO</strong>. Ya no se aceptan votos.</span>
                </div>
            }

            <!-- COLUMNA IZQUIERDA: Información del proyecto -->
            <main class="col-info">



                <h1 class="proyecto-titulo">@(proyecto?.Nombre ?? "Proyecto")</h1>

                @if (!string.IsNullOrEmpty(proyecto?.Equipo_Id))
                {
                    <div class="equipo-row">
                        <div class="equipo-avatar">@GetInitials(proyecto.Equipo_Id)</div>
                        <span class="equipo-nombre">Equipo @proyecto.Equipo_Id</span>
                    </div>
                }

                <!-- Imagen / Banner del proyecto -->
                <div class="proyecto-imagen">
                    <img src="@(string.IsNullOrEmpty(proyecto?.ImagenUrl) ? "images/Proyectos-default.jpg" : proyecto.ImagenUrl)" alt="@proyecto?.Nombre" style="width:100%; height:100%; object-fit:cover;" />
                </div>

                <!-- Descripción -->
                <div class="descripcion-card">
                    <div class="descripcion-titulo">
                        <img src="images/portafolio-logo.png" alt="Portafolio" class="descripcion-icon" />
                        <h2>Descripción del Proyecto</h2>
                    </div>
                    <p class="descripcion-texto">@(proyecto?.Descripcion ?? "")</p>
                    <div class="descripcion-acciones">
                        <button class="btn-ver-comentarios" @onclick="VerComentarios">Ver comentarios</button>
                    </div>


                </div>

            </main>

            <!-- COLUMNA DERECHA: Feedback + Votación -->
            <aside class="col-sidebar">

                <!-- Panel de feedback -->
                <div class="sidebar-card feedback-card" id="comentarios">
                    <h3 class="sidebar-title">Envía tu Feedback</h3>
                    <p class="sidebar-subtitle">Comparte tus impresiones antes de votar</p>

                    @if (YaTieneComentario)
                    {
                        <div class="alert-ok" style="margin-bottom: 1rem;">
                            Ya has dejado un comentario en este proyecto.
                        </div>
                    }

                    <div class="feedback-section-label">COMENTARIOS DE FEEDBACK</div>

                    <textarea
                        class="feedback-textarea"
                        placeholder="Escribe aquí tus comentarios sobre el proyecto para que el equipo pueda mejorar..."
                        @bind="comentarioTexto"
                        @bind:event="oninput"
                        rows="6"
                        disabled="@(enviandoComentario || YaTieneComentario)">
                    </textarea>

                    @if (!string.IsNullOrEmpty(mensajeComentario))
                    {
                        <div class="alert-comentario @(comentarioOk ? "alert-ok" : "alert-err")">
                            @mensajeComentario
                        </div>
                    }

                    <button class="btn-enviar-feedback" @onclick="EnviarComentario" disabled="@(enviandoComentario || string.IsNullOrWhiteSpace(comentarioTexto) || YaTieneComentario)">
                        @if (enviandoComentario)
                        {
                            <span class="spinner-sm"></span>
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                                <path d="M22 2L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M22 2L15 22l-4-9-9-4 20-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>Enviar Feedback</span>
                        }
                    </button>

                    <div class="feedback-info-box">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                            <circle cx="12" cy="12" r="10" stroke="#6366f1" stroke-width="2"/>
                            <path d="M12 8v4" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/>
                            <path d="M12 16h.01" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <span>Tu feedback será compartido de forma constructiva con los creadores del proyecto.</span>
                    </div>

                </div>

                <!-- Botón de votar -->
                <div class="sidebar-card votar-card">

                    <!-- Badge de estado -->
                    @if (votacion != null)
                    {
                        <div class="estado-badge" style="margin-bottom: 1rem;">
                            @if (votacion.Estado == 0)
                            {
                                <span class="badge badge-abierta">Votación Abierta</span>
                            }
                            else if (votacion.Estado == 1)
                            {
                                <span class="badge badge-pausada">Votación Pausada</span>
                            }
                            else if (votacion.Estado == 2)
                            {
                                <span class="badge badge-finalizada">Votación Finalizada</span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(mensajeVoto))
                    {
                        <div class="alert-voto @(votoOk ? "alert-ok" : "alert-err")">@mensajeVoto</div>
                    }
                    <button class="btn-votar-proyecto" @onclick="Votar" disabled="@(votando || votoOk || limiteAlcanzado || (votacion?.Estado != 0))">
                        @if (votando)
                        {
                            <span class="spinner-sm"></span>
                            <span>Procesando tu voto...</span>
                        }
                        else if (votoOk)
                        {
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                                <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>✓ ¡Voto registrado!</span>
                        }
                        else if (limiteAlcanzado)
                        {
                            <span>Límite de votos alcanzado</span>
                        }
                        else if (votacion?.Estado == 1)
                        {
                            <span>Votación en pausa</span>
                        }
                        else if (votacion?.Estado == 2)
                        {
                            <span>Votación finalizada</span>
                        }
                        else
                        {
                            <span>Votar por este proyecto</span>
                        }
                    </button>
                    <p class="votar-nota">
                        @if (!votoOk && votacion?.Estado == 0 && !limiteAlcanzado)
                        {
                            <span>Tu voto es único y final para este evento</span>
                        }
                        else if (limiteAlcanzado)
                        {
                            <span>Ya no puedes votar por más proyectos</span>
                        }
                        else if (votacion?.Estado != 0)
                        {
                            <span>Esta votación no está disponible en este momento</span>
                        }
                        else if (votoOk)
                        {
                            <span>Gracias por tu participación</span>
                        }
                    </p>
                </div>

            </aside>
        </div>
    }
</div>

<style>
    .detalles-wrapper {
        min-height: 100vh;
        background-color: #f8f9fc;
        font-family: 'Inter', sans-serif;
    }

    .header-principal {
        grid-column: 1 / -1;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        margin-bottom: 0.25rem;
    }

    .btn-volver {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        background: white;
        border: 1px solid #e2e8f0;
        color: #64748b;
        padding: 0.4rem 0.8rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-volver:hover { 
        background: #f8f9fc; 
        border-color: #ddd6fe; 
        color: #7c3aed; 
    }

    .page-header-row {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .brand-name {
        font-weight: 800;
        font-size: 1.2rem;
        color: #4c1d95;
        letter-spacing: -0.02em;
    }

    .logo-icon.small {
        display: flex;
        align-items: center;
    }

    .evento-logo-img {
        width: 20px !important;
        height: 20px !important;
        object-fit: contain;
    }


    .detalles-layout {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 2rem;
        align-items: start;
    }

    .col-info { display: flex; flex-direction: column; gap: 1.5rem; }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #15803d;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        letter-spacing: 0.05em;
        width: fit-content;
    }
    .dot-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        animation: pulse-green 1.5s ease-in-out infinite;
    }
    @@keyframes pulse-green {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
    }

    .proyecto-titulo {
        font-size: 2.4rem;
        font-weight: 900;
        color: #0f172a;
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin: 0;
    }

    .equipo-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .equipo-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #9333ea, #7c3aed);
        color: white;
        font-size: 0.75rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .equipo-nombre { color: #475569; font-size: 0.9rem; font-weight: 600; }

    .proyecto-imagen {
        height: 300px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    .imagen-overlay {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .descripcion-card {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        border: 1px solid #f1f5f9;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
    .descripcion-titulo {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1rem;
    }
    .descripcion-titulo h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #bf65b0;
    }
    .descripcion-icon {
        width: 24px;
        height: 24px;
        object-fit: contain;
    }
    .team-section {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f1f5f9;
    }
    .team-name-text {
        color: #000000 !important;
    }
    .descripcion-texto {
        color: #475569;
        line-height: 1.75;
        font-size: 0.95rem;
        margin: 0;
    }

    .descripcion-acciones {
        margin-top: 1.25rem;
    }
    .btn-ver-comentarios {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f5f3ff;
        color: #5b21b6;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s, transform 0.2s, border-color 0.2s;
    }
    .btn-ver-comentarios:hover {
        background: #ede9fe;
        border-color: #c4b5fd;
        transform: translateY(-1px);
    }

    .col-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: sticky;
        top: 5rem;
    }
    .sidebar-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        padding: 1.5rem;
    }
    .sidebar-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 0.25rem 0;
    }
    .sidebar-subtitle {
        color: #94a3b8;
        font-size: 0.82rem;
        margin: 0 0 1.25rem 0;
    }

    .feedback-section-label {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: #94a3b8;
        margin-bottom: 0.75rem;
    }

    .feedback-textarea {
        width: 100%;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1rem;
        font-size: 0.88rem;
        color: #1e293b;
        font-family: 'Inter', sans-serif;
        resize: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        background: #fafbfc;
        box-sizing: border-box;
        outline: none;
    }
    .feedback-textarea:focus {
        border-color: #a78bfa;
        box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.15);
        background: white;
    }
    .feedback-textarea::placeholder { color: #cbd5e1; }
    .feedback-textarea:disabled { opacity: 0.6; cursor: not-allowed; }

    .btn-enviar-feedback {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: #7c3aed;
        color: white;
        border: 1px solid #6d28d9;
        border-radius: 12px;
        padding: 0.65rem 1rem;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 0.75rem;
        box-shadow: 0 2px 8px rgba(124, 58, 237, 0.2);
    }
    .btn-enviar-feedback:hover:not(:disabled) { 
        background: #6d28d9; 
        border-color: #5b21b6;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
        transform: translateY(-1px);
    }
    .btn-enviar-feedback:disabled { 
        background: #e8e7f0; 
        color: #b0acb8; 
        border-color: #d1cce0;
        cursor: not-allowed; 
        opacity: 1;
        box-shadow: none;
    }

    .feedback-info-box {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        background: #f8f9ff;
        border: 1px solid #e0e7ff;
        border-radius: 12px;
        padding: 0.75rem;
        margin-top: 0.75rem;
        font-size: 0.78rem;
        color: #64748b;
        line-height: 1.5;
    }
    .feedback-info-box svg { flex-shrink: 0; margin-top: 1px; }

    .comentarios-lista { margin-top: 1rem; }
    .comentarios-lista-titulo {
        font-size: 0.72rem;
        font-weight: 700;
        color: #94a3b8;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }
    .comentario-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        background: #f8f9fc;
        border-radius: 16px;
        padding: 1rem;
        margin-bottom: 0.75rem;
        font-size: 0.92rem;
        color: #475569;
        line-height: 1.6;
        border: 1px solid #e5e7eb;
    }
    .comentario-card {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1rem;
        background: white;
        border-radius: 18px;
        border: 1px solid #ede9fe;
    }
    .comentario-info {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        font-size: 0.78rem;
        font-weight: 700;
        color: #7c3aed;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .comentario-fecha {
        color: #64748b;
        font-weight: 600;
        text-transform: none;
    }
    .comentario-item p {
        margin: 0;
        color: #334155;
    }
    .comentario-item svg { flex-shrink: 0; margin-top: 2px; }

    .votar-card { padding: 1.25rem; }
    .btn-votar-proyecto {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        background: linear-gradient(135deg, #9333ea 0%, #7c3aed 100%);
        color: white;
        border: none;
        border-radius: 16px;
        padding: 1rem 1.5rem;
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 6px 20px rgba(147, 51, 234, 0.3);
        letter-spacing: -0.01em;
    }
    .btn-votar-proyecto:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(147, 51, 234, 0.4);
        filter: brightness(1.08);
    }
    .btn-votar-proyecto:disabled { background: #dbc2e2; color: white; cursor: not-allowed; transform: none; box-shadow: none; }
    .votar-nota {
        text-align: center;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #94a3b8;
        margin: 0.75rem 0 0 0;
    }

    .alert-ok {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        font-size: 0.83rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }
    .alert-err {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        font-size: 0.83rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }
    .alert-comentario { margin-top: 0.6rem; }
    .alert-voto { }
    .alert-limite { 
        background: #fff7ed; 
        color: #9a3412; 
        border: 1px solid #fed7aa; 
        border-radius: 12px; 
        padding: 0.75rem 1.25rem; 
        font-size: 0.9rem; 
        font-weight: 700; 
        margin-bottom: 1.5rem; 
        display: flex; 
        align-items: center; 
        gap: 0.8rem; 
    }
    .alert-top { grid-column: 1 / -1; }

    .loader-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 5rem;
        color: #64748b;
    }
    .spinner {
        width: 36px; height: 36px;
        border: 4px solid #f3e8ff;
        border-top: 4px solid #9333ea;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
        margin-bottom: 1rem;
    }
    .spinner-sm {
        display: inline-block;
        width: 14px; height: 14px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .error-state {
        text-align: center;
        padding: 4rem;
        color: #94a3b8;
    }

    /* Alertas de Estado */
    .alert-pausada {
        background-color: #fef3c7;
        border-left: 4px solid #f59e0b;
        color: #92400e;
    }

    .alert-finalizada {
        background-color: #e0e7ff;
        border-left: 4px solid #6366f1;
        color: #312e81;
    }

    /* Badges de Estado */
    .estado-badge {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
    }

    .badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-size: 0.875rem;
        font-weight: 600;
        text-align: center;
    }

    .badge-abierta {
        background-color: #dcfce7;
        color: #166534;
        border: 1px solid #22c55e;
    }

    .badge-pausada {
