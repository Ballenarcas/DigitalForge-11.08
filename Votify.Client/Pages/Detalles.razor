@page "/{VotacionId}/proyectos/{ProyectoId}"
@using Votify.Client.DTOs
@using Votify.Client.Services
@inject ProyectosService ProyectosService
@inject VotacionesService VotacionesService
@inject NavigationManager Nav

<div class="detalles-wrapper">

    <!-- ===== CONTENIDO PRINCIPAL ===== -->
    @if (cargando)
    {
        <div class="loader-center">
            <div class="spinner"></div>
            <p>Cargando proyecto...</p>
        </div>
    }
    else if (proyecto == null)
    {
        <div class="error-state">
            <p>No se pudo cargar el proyecto.</p>
        </div>
    }
    else
    {
        <div class="detalles-layout">

            <!-- breadcrumb dentro del layout -->
            <nav class="breadcrumb-nav breadcrumb-full">
                <button class="btn-volver" @onclick="Volver">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                        <path d="M15 19L8 12L15 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Volver
                </button>
                <span class="breadcrumb-sep">›</span>
                <span class="breadcrumb-item">Evento</span>
                <span class="breadcrumb-sep">›</span>
                <span class="breadcrumb-item active">@(proyecto?.Nombre ?? "Cargando...")</span>
            </nav>

            <!-- COLUMNA IZQUIERDA: Información del proyecto -->
            <main class="col-info">

                <div class="status-badge">
                    <span class="dot-pulse"></span>
                    VOTACIÓN ABIERTA
                </div>

                <h1 class="proyecto-titulo">@proyecto.Nombre</h1>

                @if (!string.IsNullOrEmpty(proyecto.Equipo_Id))
                {
                    <div class="equipo-row">
                        <div class="equipo-avatar">@GetInitials(proyecto.Equipo_Id)</div>
                        <span class="equipo-nombre">Equipo @proyecto.Equipo_Id</span>
                    </div>
                }

                <!-- Imagen / Banner del proyecto -->
                <div class="proyecto-imagen" style="background: @GetGradient(proyecto.Id)">
                    <div class="imagen-overlay">
                        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48" opacity="0.35">
                            <rect x="8" y="16" width="48" height="34" rx="6" stroke="white" stroke-width="3"/>
                            <circle cx="24" cy="29" r="5" stroke="white" stroke-width="3"/>
                            <path d="M8 42l12-10 8 8 10-12 14 12" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                </div>

                <!-- Descripción -->
                <div class="descripcion-card">
                    <div class="descripcion-titulo">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                            <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke="#9333ea" stroke-width="2" stroke-linecap="round"/>
                            <rect x="9" y="3" width="6" height="4" rx="1" stroke="#9333ea" stroke-width="2"/>
                            <path d="M9 12h6M9 16h4" stroke="#9333ea" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <h2>Descripción del Proyecto</h2>
                    </div>
                    <p class="descripcion-texto">@proyecto.Descripcion</p>
                </div>

            </main>

            <!-- COLUMNA DERECHA: Feedback + Votación -->
            <aside class="col-sidebar">

                <!-- Panel de feedback -->
                <div class="sidebar-card feedback-card">
                    <h3 class="sidebar-title">Envía tu Feedback</h3>
                    <p class="sidebar-subtitle">Comparte tus impresiones antes de votar</p>

                    <div class="feedback-section-label">COMENTARIOS DE FEEDBACK</div>

                    <textarea
                        class="feedback-textarea"
                        placeholder="Escribe aquí tus comentarios sobre el proyecto para que el equipo pueda mejorar..."
                        @bind="comentarioTexto"
                        rows="6"
                        disabled="@enviandoComentario">
                    </textarea>

                    @if (!string.IsNullOrEmpty(mensajeComentario))
                    {
                        <div class="alert-comentario @(comentarioOk ? "alert-ok" : "alert-err")">
                            @mensajeComentario
                        </div>
                    }

                    <button class="btn-enviar-feedback" @onclick="EnviarComentario" disabled="@(enviandoComentario || string.IsNullOrWhiteSpace(comentarioTexto))">
                        @if (enviandoComentario)
                        {
                            <span class="spinner-sm"></span>
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                                <path d="M22 2L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M22 2L15 22l-4-9-9-4 20-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>Enviar Feedback</span>
                        }
                    </button>

                    <div class="feedback-info-box">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                            <circle cx="12" cy="12" r="10" stroke="#6366f1" stroke-width="2"/>
                            <path d="M12 8v4" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/>
                            <path d="M12 16h.01" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <span>Tu feedback será compartido de forma constructiva con los creadores del proyecto.</span>
                    </div>

                    <!-- Comentarios ya enviados -->
                    @if (comentarios.Any())
                    {
                        <div class="comentarios-lista">
                            <div class="comentarios-lista-titulo">@comentarios.Count comentario(s) enviado(s)</div>
                            @foreach (var c in comentarios)
                            {
                                <div class="comentario-item">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                                        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="#9333ea" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span>@c</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Botón de votar -->
                <div class="sidebar-card votar-card">
                    @if (!string.IsNullOrEmpty(mensajeVoto))
                    {
                        <div class="alert-voto @(votoOk ? "alert-ok" : "alert-err")">@mensajeVoto</div>
                    }
                    <button class="btn-votar-proyecto" @onclick="Votar" disabled="@(votando || votoOk)">
                        @if (votando)
                        {
                            <span class="spinner-sm"></span>
                            <span>Procesando...</span>
                        }
                        else if (votoOk)
                        {
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                                <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>¡Voto Registrado!</span>
                        }
                        else
                        {
                            <span>Votar por este Proyecto</span>
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                                <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 000-7.78z" fill="currentColor"/>
                            </svg>
                        }
                    </button>
                    <p class="votar-nota">TU ELECCIÓN ES ÚNICA Y FINAL PARA ESTE EVENTO</p>
                </div>

            </aside>
        </div>
    }
</div>

<style>
    /* ── Reset y base ── */
    .detalles-wrapper {
        min-height: 100vh;
        background-color: #f8f9fc;
        font-family: 'Inter', sans-serif;
    }

    /* ── Breadcrumb dentro del contenido ── */
    .breadcrumb-full {
        grid-column: 1 / -1;
        margin-bottom: 0.25rem;
    }
    .breadcrumb-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .btn-volver {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        background: white;
        border: 1px solid #e2e8f0;
        color: #64748b;
        padding: 0.4rem 0.8rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-volver:hover { background: #f8f9fc; border-color: #ddd6fe; color: #7c3aed; }
    .breadcrumb-sep { color: #cbd5e1; font-size: 0.9rem; }
    .breadcrumb-item { color: #94a3b8; font-size: 0.85rem; font-weight: 500; }
    .breadcrumb-item.active { color: #7c3aed; font-weight: 700; }

    /* ── Layout ── */
    .detalles-layout {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 2rem;
        align-items: start;
    }

    /* ── Columna izquierda ── */
    .col-info { display: flex; flex-direction: column; gap: 1.5rem; }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #15803d;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        letter-spacing: 0.05em;
        width: fit-content;
    }
    .dot-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        animation: pulse-green 1.5s ease-in-out infinite;
    }
    @@keyframes pulse-green {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
    }

    .proyecto-titulo {
        font-size: 2.4rem;
        font-weight: 900;
        color: #0f172a;
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin: 0;
    }

    .equipo-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .equipo-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #9333ea, #7c3aed);
        color: white;
        font-size: 0.75rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .equipo-nombre { color: #475569; font-size: 0.9rem; font-weight: 600; }

    .proyecto-imagen {
        height: 300px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    .imagen-overlay {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .descripcion-card {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        border: 1px solid #f1f5f9;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
    .descripcion-titulo {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1rem;
    }
    .descripcion-titulo h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #9333ea;
    }
    .descripcion-texto {
        color: #475569;
        line-height: 1.75;
        font-size: 0.95rem;
        margin: 0;
    }

    /* ── Columna derecha (sidebar) ── */
    .col-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: sticky;
        top: 5rem;
    }
    .sidebar-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        padding: 1.5rem;
    }
    .sidebar-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 0.25rem 0;
    }
    .sidebar-subtitle {
        color: #94a3b8;
        font-size: 0.82rem;
        margin: 0 0 1.25rem 0;
    }

    .feedback-section-label {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: #94a3b8;
        margin-bottom: 0.75rem;
    }

    .feedback-textarea {
        width: 100%;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1rem;
        font-size: 0.88rem;
        color: #1e293b;
        font-family: 'Inter', sans-serif;
        resize: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        background: #fafbfc;
        box-sizing: border-box;
        outline: none;
    }
    .feedback-textarea:focus {
        border-color: #a78bfa;
        box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.15);
        background: white;
    }
    .feedback-textarea::placeholder { color: #cbd5e1; }
    .feedback-textarea:disabled { opacity: 0.6; cursor: not-allowed; }

    .btn-enviar-feedback {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: #f5f3ff;
        color: #7c3aed;
        border: 1px solid #ddd6fe;
        border-radius: 12px;
        padding: 0.65rem 1rem;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 0.75rem;
    }
    .btn-enviar-feedback:hover:not(:disabled) { background: #ede9fe; border-color: #c4b5fd; }
    .btn-enviar-feedback:disabled { opacity: 0.5; cursor: not-allowed; }

    .feedback-info-box {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        background: #f8f9ff;
        border: 1px solid #e0e7ff;
        border-radius: 12px;
        padding: 0.75rem;
        margin-top: 0.75rem;
        font-size: 0.78rem;
        color: #64748b;
        line-height: 1.5;
    }
    .feedback-info-box svg { flex-shrink: 0; margin-top: 1px; }

    /* Comentarios enviados */
    .comentarios-lista { margin-top: 1rem; }
    .comentarios-lista-titulo {
        font-size: 0.72rem;
        font-weight: 700;
        color: #94a3b8;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }
    .comentario-item {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        background: #f8f9fc;
        border-radius: 10px;
        padding: 0.5rem 0.75rem;
        margin-bottom: 0.4rem;
        font-size: 0.82rem;
        color: #475569;
        line-height: 1.5;
    }
    .comentario-item svg { flex-shrink: 0; margin-top: 2px; }

    /* Panel de votar */
    .votar-card { padding: 1.25rem; }
    .btn-votar-proyecto {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        background: linear-gradient(135deg, #9333ea 0%, #7c3aed 100%);
        color: white;
        border: none;
        border-radius: 16px;
        padding: 1rem 1.5rem;
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 6px 20px rgba(147, 51, 234, 0.3);
        letter-spacing: -0.01em;
    }
    .btn-votar-proyecto:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(147, 51, 234, 0.4);
        filter: brightness(1.08);
    }
    .btn-votar-proyecto:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }
    .votar-nota {
        text-align: center;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #94a3b8;
        margin: 0.75rem 0 0 0;
    }

    /* Alerts */
    .alert-ok {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        font-size: 0.83rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }
    .alert-err {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        font-size: 0.83rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }
    .alert-comentario { margin-top: 0.6rem; }
    .alert-voto { }

    /* Spinners */
    .loader-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 5rem;
        color: #64748b;
    }
    .spinner {
        width: 36px; height: 36px;
        border: 4px solid #f3e8ff;
        border-top: 4px solid #9333ea;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
        margin-bottom: 1rem;
    }
    .spinner-sm {
        display: inline-block;
        width: 14px; height: 14px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .error-state {
        text-align: center;
        padding: 4rem;
        color: #94a3b8;
    }

    /* Responsive */
    @@media (max-width: 900px) {
        .detalles-layout {
            grid-template-columns: 1fr;
            padding: 1rem;
        }
        .col-sidebar { position: static; }
        .proyecto-titulo { font-size: 1.8rem; }
    }
</style>

@code {
    [Parameter] public string? VotacionId { get; set; }
    [Parameter] public string? ProyectoId { get; set; }

    private ProyectoDto? proyecto;
    private bool cargando = true;

    private string comentarioTexto = string.Empty;
    private bool enviandoComentario = false;
    private string? mensajeComentario;
    private bool comentarioOk = false;
    private List<string> comentarios = new();

    private bool votando = false;
    private bool votoOk = false;
    private string? mensajeVoto;

    // TODO: vendrá del sistema de autenticación
    private readonly string usuarioTesterId = "ce932822-2615-46fd-ab8c-7f5164ca2414";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(ProyectoId))
            {
                proyecto = await ProyectosService.ObtenerProyectoAsync(ProyectoId);
                comentarios = await ProyectosService.ObtenerComentariosAsync(ProyectoId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando proyecto: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task EnviarComentario()
    {
        if (string.IsNullOrWhiteSpace(comentarioTexto) || string.IsNullOrEmpty(ProyectoId)) return;

        enviandoComentario = true;
        mensajeComentario = null;

        try
        {
            await ProyectosService.AgregarComentarioAsync(ProyectoId, comentarioTexto);
            comentarios.Insert(0, comentarioTexto);
            comentarioTexto = string.Empty;
            mensajeComentario = "¡Comentario enviado correctamente!";
            comentarioOk = true;
        }
        catch (Exception ex)
        {
            mensajeComentario = $"Error al enviar: {ex.Message}";
            comentarioOk = false;
        }
        finally
        {
            enviandoComentario = false;
        }
    }

    private async Task Votar()
    {
        if (string.IsNullOrEmpty(VotacionId) || string.IsNullOrEmpty(ProyectoId)) return;

        votando = true;
        mensajeVoto = null;

        try
        {
            var dto = new VotarDto
            {
                VotacionId = VotacionId,
                ProyectoId = ProyectoId,
                VotanteId = usuarioTesterId
            };
            await VotacionesService.EmitirVotoAsync(VotacionId, dto);
            mensajeVoto = "¡Tu voto ha sido registrado con éxito!";
            votoOk = true;
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            if (msg.Contains("\"Error\""))
                msg = System.Text.RegularExpressions.Regex.Match(msg, "\"Error\":\"(.*?)\"").Groups[1].Value;
            mensajeVoto = string.IsNullOrEmpty(msg) ? ex.Message : msg;
            votoOk = false;
        }
        finally
        {
            votando = false;
        }
    }

    private void Volver() => Nav.NavigateTo($"/{VotacionId}/proyectos/");

    private string GetGradient(string id)
    {
        if (string.IsNullOrEmpty(id)) return "linear-gradient(135deg, #9333ea, #7c3aed)";
        var gradients = new[]
        {
            "linear-gradient(135deg, #2E8B98, #1a5f6b)",
            "linear-gradient(135deg, #4D6B4A, #2d4a2a)",
            "linear-gradient(135deg, #9333ea, #7c3aed)",
            "linear-gradient(135deg, #0f766e, #115e59)",
            "linear-gradient(135deg, #b45309, #92400e)",
            "linear-gradient(135deg, #1d4ed8, #1e40af)",
        };
        var index = Math.Abs(id.GetHashCode()) % gradients.Length;
        return gradients[index];
    }

    private string GetInitials(string equipoId)
    {
        if (string.IsNullOrEmpty(equipoId)) return "??";
        // Si es un GUID, tomamos las dos primeras letras
        return equipoId.Length >= 2 ? equipoId[..2].ToUpper() : equipoId.ToUpper();
    }
}
