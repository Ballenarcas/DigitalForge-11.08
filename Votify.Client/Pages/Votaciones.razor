@page "/votaciones"
@using Votify.Client.DTOs
@using Votify.Client.Utilities
@inject Votify.Client.Services.VotacionesService VotacionesService
@inject Votify.Client.Services.EventosService EventosService
@inject NavigationManager Nav
@inject Votify.Client.Services.AppState AppState
@inject AuthenticationStateProvider AuthStateProvider

<div class="main-container">
    @if (mostrarModalConfirmacion)
    {
        <div class="modal-overlay" @onclick="CerrarModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Confirmar eliminación</h3>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro de que deseas <strong>eliminar permanentemente</strong> esta votación?</p>
                    <p class="votacion-nombre"><strong>@votacionAEliminar?.Nombre</strong></p>
                    <p class="warning-text">Esta acción <strong>no se puede deshacer</strong>.</p>
                </div>
                <div class="modal-actions">
                    <button class="btn-modal-cancel" @onclick="CerrarModal" disabled="@eliminando">
                        Cancelar
                    </button>
                    <button class="btn-modal-delete" @onclick="ConfirmarEliminar" disabled="@eliminando">
                        @if (eliminando)
                        {
                            <span class="btn-spinner"></span>
                            <span>Eliminando...</span>
                        }
                        else
                        {
                            <span>Sí, eliminar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
    <div class="header-principal">
        <button class="btn-volver" @onclick='() => Nav.NavigateTo("/")'>
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                <path d="M15 19L8 12L15 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Eventos
        </button>
        <div class="header-actions" style="display:flex; gap:0.75rem; flex-wrap:wrap;">
            @if (Rol == "ORGANIZADOR")
            {
                <button class="btn-crear" @onclick="IrACrearVotacion">
                    <span>+</span> Nueva Votación
                </button>
                <button class="btn-crear" @onclick="IrAGestionRoles" style="background-color:#D4A2F5; border-color:#D4A2F5;">
                    Gestionar Roles
                </button>
            }
            @if (Rol != null)
            {
                <button class="btn-crear" style="background-color:#D4A2F5; border-color:#D4A2F5;" @onclick="IrACrearEquipo">
                    Equipos
                </button>
            }
        </div>

    </div>

    <div class="page-header-row">
        <div class="logo-container">
            <div class="logo-icon small">
                <img src="images/votaciones-logo.png" alt="Votaciones logo" class="evento-logo-img" style="width:20px;height:20px;" />
            </div>
            <span class="brand-name">Votaciones de @(AppState.EventoNombre ?? "Evento")</span>
        </div>
    </div>

    <div class="content-wrapper">

        
        @if (listaVotaciones == null)
        {
            <div class="loader-container">
                <div class="spinner"></div>
                <p>Cargando...</p>
            </div>
        }
        else if (!listaVotaciones.Any())
        {
            <div class="empty-state">
                <p>No hay votaciones disponibles.</p>
            </div>
        }
        else
        {
            <div class="votaciones-grid">
                @foreach (var v in listaVotaciones)
                {
                    var ahora = DateTime.UtcNow;
                    var diasFaltantes = (v.FechaInicio - ahora).TotalDays;
                    var minutosRestantes = Math.Max(0, (v.FechaFin - ahora).TotalMinutes);


                    bool noIniciada = v.FechaInicio > ahora;
                    bool finalizadaPorTiempo = v.Estado == 0 && v.FechaFin <= ahora;
                    bool estaActiva = !noIniciada && !finalizadaPorTiempo && v.Estado == 0;
                    bool estaPausada = !noIniciada && !finalizadaPorTiempo && v.Estado == 1;
                    bool estaFinalizada = finalizadaPorTiempo || v.Estado == 2;

                    var cardClass = noIniciada ? "card-pending" : estaActiva ? "card-active" : estaPausada ? "card-paused" : "card-ended";
                    var pillClass = noIniciada ? "pill-pending" : estaActiva ? "pill-active" : estaPausada ? "pill-paused" : "pill-ended";

                    <div class="votacion-card @cardClass">
                        <div class="card-cover">
                            <img src="@(string.IsNullOrEmpty(v.ImagenUrl) ? "images/Votación-default.jpg" : v.ImagenUrl)" alt="@v.Nombre" onerror="this.src='images/Votación-default.jpg'" />
                        </div>
                        <div class="card-content">
                            <div class="card-type-hint">VOTACIÓN @v.Tipo</div>

                            <h3>@v.Nombre</h3>
                            
                            <div class="description-container">
                                <p class="descripcion-breve">Límite de votos: @v.LimiteProy proyectos.</p>
                            </div>

                            <div class="info-row">
                                <div class="date-row">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                                        <path d="M8 2V5M16 2V5M3.5 9.09H20.5M21 8.5V17C21 20 19.5 22 16 22H8C4.5 22 3 20 3 17V8.5C3 5.5 4.5 3.5 8 3.5H16C19.5 3.5 21 5.5 21 8.5Z" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M15.6947 13.7H15.7037M15.6947 16.7H15.7037M11.9955 13.7H12.0045M11.9955 16.7H12.0045M8.29639 13.7H8.30537M8.29639 16.7H8.30537" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span>@v.FechaInicio.ToLocalTime().ToString("dd/MM/yy") - @v.FechaFin.ToLocalTime().ToString("dd/MM/yy")</span>
                                </div>
                                <div class="status-indicator @(noIniciada ? "status-pending" : estaActiva ? "status-active" : estaPausada ? "status-paused" : "status-ended")">
                                    <span class="status-dot @(estaActiva ? "pulse" : "")"></span>
                                    @(noIniciada ? "Programada" : estaActiva ? "Activa" : estaPausada ? "Pausada" : "Finalizada")
                                </div>
                            </div>

                            @if (noIniciada)
                            {
                                <button class="btn-votar btn-disabled" disabled title="La votación aún no ha comenzado">
                                    No iniciada
                                </button>
                            }
                            else if (estaActiva)
                            {
                                <button class="btn-votar btn-active" @onclick="() => Votar(v.Id)" title="¡Haz tu voto ahora!">
                                    Votar ahora
                                </button>
                            }
                            else if (estaPausada)
                            {
                                <button class="btn-votar btn-disabled" disabled title="La votación está en pausa">
                                    Votación pausada
                                </button>
                            }
                            else
                            {
                                <button class="btn-votar btn-closed" disabled title="Esta votación ya ha finalizado">
                                    Votación cerrada
                                </button>
                            }

                            <div class="card-footer">
                                <div class="footer-actions">
                                    @if (estaActiva || estaPausada || estaFinalizada)
                                    {
                                        <button class="btn-ver" @onclick="() => VerResultados(v.Id)" title="Ver resultados">
                                            Resultados
                                        </button>
                                    }
                                    @if (Rol == "ORGANIZADOR")
                                    {
                                        @if (!estaFinalizada)
                                        {
                                            <button class="btn-ver" @onclick="() => Gestionar(v.Id)" title="Editar configuración">
                                                Editar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-eliminar" @onclick="() => EliminarVotacion(v.Id)" title="Eliminar esta votación">
                                                Eliminar
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? EventoNombre { get; set; }

    [SupplyParameterFromQuery]
    public string? EventoId { get; set; }

    private List<VotacionDto>? listaVotaciones;
    private bool mostrarModalConfirmacion = false;
    private VotacionDto? votacionAEliminar;
    private bool eliminando = false;
    private bool isAuthenticated = false;
    private string? Rol = null;
    private Dictionary<string, bool> operacionesEnProgreso = new();
    private Dictionary<string, string?> mensajesErrores = new();


    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(EventoNombre))
        {
            AppState.EventoNombre = EventoNombre;
        }
        if (!string.IsNullOrEmpty(EventoId))
        {
            AppState.EventoId = EventoId;
        }

        // Cargar fechas del evento para restringir la creación de votaciones
        if (!string.IsNullOrEmpty(AppState.EventoId))
        {
            try
            {
                var evento = await EventosService.ObtenerEvento(AppState.EventoId);
                if (evento != null)
                {
                    AppState.EventoFechaInicio = evento.FechaInicio;
                    AppState.EventoFechaFin = evento.FechaFin;
                }
            }
            catch { /* no crítico, la validación de fechas es secundaria */ }
        }

        await CargarVotaciones();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        if (isAuthenticated)
        {
            var usuarioId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                            ?? authState.User.FindFirst("sub")?.Value
                            ?? authState.User.FindFirst("nameid")?.Value;
            
            if (!string.IsNullOrEmpty(AppState.EventoId))
            {
                Rol = await EventosService.ObtenerRolEnEvento(AppState.EventoId);
            }
        }
    }

    private async Task CargarVotaciones()
    {
        try
        {
            if (!string.IsNullOrEmpty(AppState.EventoId))
            {
                listaVotaciones = await VotacionesService.ObtenerVotacionesPorEvento(AppState.EventoId);
            }
            else
            {
                // Si no hay evento, la lista se queda vacía o se inicializa
                listaVotaciones = new List<VotacionDto>();
            }
        }
        catch (Exception ex)
        {
            var errorMsg = ErrorMessageParser.ExtractErrorMessage(ex.Message);
            Console.WriteLine($"Error cargando votaciones: {errorMsg}");
            listaVotaciones = new List<VotacionDto>();
        }
    }

    private void IrACrearVotacion() => Nav.NavigateTo($"/nueva-votacion?eventoId={AppState.EventoId}");
    private void IrACrearEquipo() => Nav.NavigateTo($"/nuevo-equipo?eventoId={AppState.EventoId}");
    private void IrAGestionRoles() => Nav.NavigateTo($"/evento/{AppState.EventoId}/roles");
    private void Gestionar(string id) => Nav.NavigateTo($"/votacion/{id}");
    private void VerResultados(string id)
    {
        var votacion = listaVotaciones?.FirstOrDefault(v => v.Id == id);
        if (votacion != null)
        {
            var tipo = votacion.Tipo?.ToUpper() ?? "";
            if (tipo == "MULTICRITERIO" || tipo == "MULTICRITERIO_PUBLICO")
            {
                Nav.NavigateTo($"/{id}/resultados-multicriterio/");
            }
            else
            {
                Nav.NavigateTo($"/{id}/resultados/");
            }
        }
    }
    private void Votar(string id) => Nav.NavigateTo($"/{id}/proyectos/");

    private void EliminarVotacion(string id)
    {
        var votacion = listaVotaciones?.FirstOrDefault(v => v.Id == id);
        if (votacion != null)
        {
            votacionAEliminar = votacion;
            mostrarModalConfirmacion = true;
        }
    }

    private void CerrarModal()
    {
        mostrarModalConfirmacion = false;
        votacionAEliminar = null;
    }

    private async Task ConfirmarEliminar()
    {
        if (votacionAEliminar?.Id == null) return;

        eliminando = true;
        try
        {
            await VotacionesService.EliminarVotacion(votacionAEliminar.Id);
            await CargarVotaciones();
            CerrarModal();
        }
        catch (Exception ex)
        {
            var errorMsg = ErrorMessageParser.ExtractErrorMessage(ex.Message);
            Console.WriteLine($"Error eliminando votación: {errorMsg}");
        }
        finally
        {
            eliminando = false;
        }
    }

    private string GetTiempoRestante(double minutosRestantes)
    {
        if (minutosRestantes <= 0) return "Votación cerrada";
        if (minutosRestantes < 1) return "Menos de 1 minuto restante";
        if (minutosRestantes < 60) return $"{(int)minutosRestantes} minutos restantes";
        
        var horasRestantes = minutosRestantes / 60;
        if (horasRestantes < 24) return $"{(int)horasRestantes}h {(int)(minutosRestantes % 60)}min restantes";
        
        var diasRestantes = horasRestantes / 24;
        return $"{(int)diasRestantes}d {(int)(horasRestantes % 24)}h restantes";
    }
}

