@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Votify.Client.DTOs
@using Votify.Client.Services
@using Votify.Client.Utilities
@inject NavigationManager Nav
@inject EventosService EventosService
@inject AppState AppState
@inject AuthenticationStateProvider AuthStateProvider

<div class="main-container">
    <div class="header-principal">
        <div class="logo-container">
            <div class="logo-icon small">
                <img src="images/evento-logo.png" alt="Evento logo" class="evento-logo-img" style="width:20px;height:20px;" />
            </div>
            <span class="brand-name">Eventos</span>
        </div>
        <div class="header-actions">
            <button class="btn-crear" @onclick='() => Nav.NavigateTo("/nuevo-evento")'>
                <span>+</span> Nuevo Evento
            </button>
        </div>
    </div>

    <div class="content-wrapper">

        @if (listaEventos == null)
        {
            <div class="loader-container">
                <div class="spinner"></div>
                <p>Cargando...</p>
            </div>
        }
        else if (!listaEventos.Any())
        {
            <div class="empty-state">
                <p>No hay eventos disponibles.</p>
            </div>
        }
        else
        {
            <div class="votaciones-grid">
                @foreach (var e in listaEventos)
                {
                    var ahora = DateTime.UtcNow;
                    var yaInicio  = ahora >= e.FechaInicio;
                    var yaFinalizo = ahora >= e.FechaFin;

                    <div class="votacion-card @(yaFinalizo ? "card-ended" : yaInicio ? "card-active" : "card-pending") @(enteringIds.Contains(e.Id!) ? "card-entering" : "") @(leavingIds.Contains(e.Id!) ? "card-leaving" : "") @(updatingIds.Contains(e.Id!) ? "card-updating" : "")">
                        <div class="card-cover">
                            <img src="@(string.IsNullOrEmpty(e.ImagenUrl) ? "images/evento-default.png" : e.ImagenUrl)" alt="@e.Nombre" />
                        </div>
                        <div class="card-content">
                            <div class="card-type-row">
                                <div class="card-type-hint">EVENTO</div>
                                @if (e.Id != null && misRolesPorEvento.TryGetValue(e.Id, out var rolEvento))
                                {
                                    var rolClass = rolEvento.ToUpper() switch {
                                        "ORGANIZADOR" => "rol-organizador",
                                        "JURADO" => "rol-jurado",
                                        "COMPETIDOR" => "rol-competidor",
                                        _ => "rol-publico"
                                    };
                                    <div class="status-indicator @rolClass">
                                        <span class="status-dot"></span>
                                        @rolEvento
                                    </div>
                                }
                            </div>

                            <h3>@e.Nombre</h3>
                            
                            <div class="description-container">
                                <p class="descripcion-breve">@e.Descripcion</p>
                            </div>

                            <div class="info-row">
                                <div class="date-row">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                                        <path d="M8 2V5M16 2V5M3.5 9.09H20.5M21 8.5V17C21 20 19.5 22 16 22H8C4.5 22 3 20 3 17V8.5C3 5.5 4.5 3.5 8 3.5H16C19.5 3.5 21 5.5 21 8.5Z" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M15.6947 13.7H15.7037M15.6947 16.7H15.7037M11.9955 13.7H12.0045M11.9955 16.7H12.0045M8.29639 13.7H8.30537M8.29639 16.7H8.30537" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span>@e.FechaInicio.ToLocalTime().ToString("dd/MM/yy") - @e.FechaFin.ToLocalTime().ToString("dd/MM/yy")</span>
                                </div>
                                <div class="status-indicator @(yaFinalizo ? "status-ended" : yaInicio ? "status-active" : "status-pending")">
                                    <span class="status-dot pulse"></span>
                                    @(yaFinalizo ? "Finalizado" : yaInicio ? "En curso" : "Pendiente")
                                </div>
                            </div>

                            @if (!misEventosIds.Contains(e.Id!))
                            {
                                <button class="btn-registrar" @onclick="() => Registrarse(e.Id!)">
                                    Participar
                                </button>
                            }
                            else if (yaInicio && !yaFinalizo)
                            {
                                <button class="btn-votar" @onclick='() => IrAVotaciones(e)'>
                                    Ver Votaciones
                                </button>
                            }
                            else if (!yaInicio && EsOrganizador(e.Id!))
                            {
                                <button class="btn-votar btn-gestionar" @onclick='() => IrAVotaciones(e)'>
                                    Gestionar Evento
                                </button>
                            }
                            else
                            {
                                <button class="btn-votar" disabled>
                                    Ver Votaciones
                                </button>
                            }

                            <div class="card-footer">
<div class="footer-actions">
                                    @if (EsOrganizador(e.Id!))
                                    {
                                        <button class="btn-editar" @onclick="() => AbrirEditor(e)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                            Editar
                                        </button>
                                        <button class="btn-eliminar-evento" @onclick="() => AbrirConfirmacionEliminar(e)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                            </svg>
                                            Eliminar
                                        </button>
                                    }
                                    else if (yaFinalizo)
                                    {
                                        <button class="btn-eliminar" @onclick="() => AbrirConfirmacionEliminar(e)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                            </svg>
                                            Eliminar
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-ver" @onclick="() => IrADetalles(e.Id!)">Detalles</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (!isAuthenticated)
{
    <div class="auth-modal-overlay">

        <div class="auth-modal-content">
            <img src="images/votify-logo.png" alt="Votify" style="height: 50px; margin-bottom: 20px;" />
            <h3 style="color: #4B1A99; font-weight: 800; margin-bottom: 10px;">¡Bienvenido a Eventos!</h3>
            <p style="color: #64748b; margin-bottom: 2rem;">Para ver la lista de eventos y participar en ellos, necesitas iniciar sesión o crear una cuenta nueva.</p>
            
            <div style="display: flex; gap: 1rem; justify-content: center;">
                <button class="btn-login-modal" @onclick='() => Nav.NavigateTo("/login")'>Iniciar Sesión</button>
                <button class="btn-crear" @onclick='() => Nav.NavigateTo("/registro")'>Crear cuenta</button>
            </div>
        </div>
    </div>
}

@if (mostrarEditor && eventoEditando != null)
{
    <div class="edit-modal-overlay" @onclick="CerrarEditor">
        <div class="edit-modal-content" @onclick:stopPropagation="true">
            <div class="edit-modal-header">
                <div class="edit-modal-title-row">
                    <span class="edit-modal-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                    </span>
                    <h2>Editar Evento</h2>
                </div>
                <button class="edit-modal-close" @onclick="CerrarEditor">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            <div class="edit-modal-body">
                <div class="edit-field">
                    <label>Nombre del evento</label>
                    <input type="text" @bind="editNombre" placeholder="Nombre del evento" class="edit-input" />
                </div>

                <div class="edit-field">
                    <label>Descripcion</label>
                    <textarea @bind="editDescripcion" placeholder="Describe el evento..." class="edit-textarea" rows="3"></textarea>
                </div>

                <div class="edit-row-dates">
                    <div class="edit-field">
                        <label>Fecha de inicio</label>
                        <input type="datetime-local" @bind="editFechaInicio" class="edit-input" />
                    </div>
                    <div class="edit-field">
                        <label>Fecha de fin</label>
                        <input type="datetime-local" @bind="editFechaFin" class="edit-input" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(editError))
                {
                    <div class="edit-error">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        @editError
                    </div>
                }
            </div>

            <div class="edit-modal-footer">
                <button class="btn-modal-cancel" @onclick="CerrarEditor" disabled="@editCargando">Cancelar</button>
                <button class="btn-modal-save" @onclick="GuardarEvento" disabled="@editCargando">
                    @if (editCargando)
                    {
                        <span class="btn-spinner"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                            <polyline points="17 21 17 13 7 13 7 21"/>
                            <polyline points="7 3 7 8 15 8"/>
                        </svg>
                        <span>Guardar Cambios</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (mostrarConfirmacionEliminar && eventoEliminando != null)
{
    <div class="delete-epic-overlay">
        @for (int i = 0; i < 8; i++)
        {
            var delay = i * 0.15;
            <div class="epic-ring" style="animation-delay: @(delay)s;"></div>
        }
        @for (int i = 0; i < 60; i++)
        {
            var angle = i * 6;
            var dist = 80 + (i % 5) * 60;
            var size = 6 + (i % 10);
            var colors = new[] { "#e94560", "#dc2626", "#7c3aed", "#ff6b6b", "#ffffff", "#621d95" };
            var color = colors[i % colors.Length];
            var delay = (i % 8) * 0.06;
            var duration = 0.6 + (i % 4) * 0.2;
            <div class="epic-particle"
                 style="
                     --angle: @angle;
                     --dist: @dist;
                     --size: @size;
                     --color: @color;
                     animation-delay: @delay.ToString("F2")s;
                     animation-duration: @duration.ToString("F2")s;
                 "></div>
        }
        @for (int i = 0; i < 40; i++)
        {
            var x = (i % 11 - 5) * 120;
            var y = -200 - (i % 7) * 80;
            var delay = i * 0.04;
            var color = i % 2 == 0 ? "#e94560" : "#ffffff";
            <div class="epic-spark" style="--sx: @x; --sy: @y; animation-delay: @delay.ToString("F2")s; background: @color; box-shadow: 0 0 6px @color; width: @(4 + i % 6)px; height: @(4 + i % 6)px;"></div>
        }

        <div class="delete-modal-center @(confirmLeaving ? "modal-epic-vanish" : "modal-epic-appear")">
            <div class="delete-modal-glare"></div>
            <div class="delete-icon-wrapper @(confirmLeaving ? "icon-epic-death" : "")">
                <div class="icon-ring-outer"></div>
                <div class="icon-ring-inner"></div>
                @if (confirmLeaving)
                {
                    <svg class="check-draw" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5"/>
                    </svg>
                }
                else
                {
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                }
            </div>
            <h2 class="@(confirmLeaving ? "title-epic-vanish" : "")">@(confirmLeaving ? "Eliminando..." : "Eliminar Evento")</h2>
            @if (!confirmLeaving)
            {
                <p>Esta a punto de eliminar <strong>@eventoEliminando.Nombre</strong>. Esta accion no se puede deshacer.</p>

                @if (!string.IsNullOrEmpty(errorEliminar))
                {
                    <div class="confirm-error">@errorEliminar</div>
                }

                <div class="confirm-modal-actions">
                    <button class="btn-epic-cancel" @onclick="CerrarConfirmacionEliminar" disabled="@eliminandoEvento">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                        Cancelar
                    </button>
                    <button class="btn-epic-delete" @onclick="ConfirmarEliminarEvento" disabled="@eliminandoEvento">
                        @if (eliminandoEvento)
                        {
                            <span class="btn-spinner"></span>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                            </svg>
                        }
                        @(confirmLeaving ? "Eliminando..." : "Si, eliminar")
                    </button>
                </div>
            }
        </div>
        @if (confirmLeaving)
        {
            <div class="white-flash"></div>
        }
    </div>
}

@code {
    private List<EventoDto>? listaEventos;
    private HashSet<string> misEventosIds = new();
    private Dictionary<string, string> misRolesPorEvento = new();
    private bool isAuthenticated = true;
    private bool mostrarEditor = false;
    private EventoDto? eventoEditando;
    private string editNombre = "";
    private string editDescripcion = "";
    private DateTime editFechaInicio;
    private DateTime editFechaFin;
    private bool editCargando = false;
    private string? editError;
    private bool mostrarConfirmacionEliminar = false;
    private EventoDto? eventoEliminando;
    private bool eliminandoEvento = false;
    private string? errorEliminar;
    private HashSet<string> enteringIds = new();
    private HashSet<string> leavingIds = new();
    private HashSet<string> updatingIds = new();
    private bool confirmLeaving = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            await CargarEventos();
        }
        else
        {
            listaEventos = new List<EventoDto>(); // Array vacío si no está autenticado
        }
    }

    private async Task CargarEventos()
    {
        try 
        {
            listaEventos = await EventosService.ObtenerEventosGenerales();

            var misEventos = await EventosService.ObtenerMisEventos();
            misEventosIds = misEventos.Where(e => e.Id != null).Select(e => e.Id!).ToHashSet();

            misRolesPorEvento.Clear();
            foreach (var id in misEventosIds)
            {
                try
                {
                    var rol = await EventosService.ObtenerRolEnEvento(id);
                    if (!string.IsNullOrEmpty(rol))
                    {
                        misRolesPorEvento[id] = rol;
                    }
                }
                catch
                {
                    Console.WriteLine($"No se pudo obtener el rol para el evento {id}");
                }
            }
        }
        catch (Exception ex)
        {
            var errorMsg = ErrorMessageParser.ExtractErrorMessage(ex.Message);
            Console.WriteLine($"Error cargando eventos: {errorMsg}");
            listaEventos = new List<EventoDto>();
        }
    }

    private async Task Registrarse(string id)
    {
        try
        {
            await EventosService.ParticiparEnEvento(id);
            // Actualizamos la lista tras registrarnos exitosamente
            await CargarEventos();
        }
        catch (Exception ex)
        {
            var errorMsg = ErrorMessageParser.ExtractErrorMessage(ex.Message);
            Console.WriteLine($"Error al registrarse en el evento: {errorMsg}");
        }
    }

    private void IrADetalles(string id)
    {
        Nav.NavigateTo($"/detalles-evento/{id}");
    }

    private bool EsOrganizador(string eventoId)
    {
        return misRolesPorEvento.TryGetValue(eventoId, out var rol)
               && rol.Equals("ORGANIZADOR", StringComparison.OrdinalIgnoreCase);
    }

    private void IrAVotaciones(EventoDto? evento)
    {
        if (AppState == null || evento == null || evento.Id == null) return;
        AppState.EventoNombre = evento.Nombre;
        AppState.EventoId = evento.Id;
        Nav.NavigateTo($"/votaciones?eventoId={evento.Id}&eventoNombre={Uri.EscapeDataString(evento.Nombre)}");
    }

    private void AbrirEditor(EventoDto evento)
    {
        eventoEditando = evento;
        editNombre = evento.Nombre;
        editDescripcion = evento.Descripcion;
        editFechaInicio = evento.FechaInicio.ToLocalTime();
        editFechaFin = evento.FechaFin.ToLocalTime();
        editError = null;
        mostrarEditor = true;
    }

    private void CerrarEditor()
    {
        mostrarEditor = false;
        eventoEditando = null;
        editError = null;
    }

    private async Task GuardarEvento()
    {
        if (eventoEditando?.Id == null) return;
        editCargando = true;
        editError = null;

        var id = eventoEditando.Id;
        updatingIds.Add(id);
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            var dto = new EventoDto
            {
                Id = eventoEditando.Id,
                Nombre = editNombre,
                Descripcion = editDescripcion,
                FechaInicio = editFechaInicio.ToUniversalTime(),
                FechaFin = editFechaFin.ToUniversalTime(),
                ImagenUrl = eventoEditando.ImagenUrl
            };
            await EventosService.ActualizarEvento(eventoEditando.Id, dto);
            await Task.Delay(400);
            updatingIds.Remove(id);
            await CargarEventos();
            enteringIds.Add(id);
            StateHasChanged();
            await Task.Delay(700);
            enteringIds.Remove(id);
            CerrarEditor();
        }
        catch (Exception ex)
        {
            updatingIds.Remove(id);
            editError = ErrorMessageParser.ExtractErrorMessage(ex.Message);
        }
        finally
        {
            editCargando = false;
        }
    }

    private void AbrirConfirmacionEliminar(EventoDto evento)
    {
        eventoEliminando = evento;
        errorEliminar = null;
        mostrarConfirmacionEliminar = true;
    }

    private void CerrarConfirmacionEliminar()
    {
        mostrarConfirmacionEliminar = false;
        eventoEliminando = null;
        errorEliminar = null;
    }

    private async Task ConfirmarEliminarEvento()
    {
        if (eventoEliminando?.Id == null) return;
        eliminandoEvento = true;
        errorEliminar = null;

        var id = eventoEliminando.Id;
        leavingIds.Add(id);
        confirmLeaving = true;
        StateHasChanged();

        try
        {
            await Task.Delay(500);
            await EventosService.EliminarEvento(id);
            await Task.Delay(350);
            leavingIds.Remove(id);
            confirmLeaving = false;
            await CargarEventos();
            enteringIds.Add(id);
            StateHasChanged();
            await Task.Delay(700);
            enteringIds.Remove(id);
            CerrarConfirmacionEliminar();
        }
        catch (Exception ex)
        {
            leavingIds.Remove(id);
            confirmLeaving = false;
            errorEliminar = ErrorMessageParser.ExtractErrorMessage(ex.Message);
        }
        finally
        {
            eliminandoEvento = false;
        }
    }
}

