@page "/login"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="icon-container">
            🗳️
        </div>
        <h1 class="title">Bienvenido a Votify</h1>
        <p class="subtitle">Inicia sesión para continuar</p>

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }

            <div class="form-group">
                <label>Correo Electrónico</label>
                <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="ejemplo@correo.com" />
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="••••••••" />
            </div>

            <div class="forgot-password">
                <a href="#">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn-primary-custom" disabled="@isLoading">
                @if(isLoading) { <span>Cargando...</span> } else { <span>Iniciar Sesión</span> }
            </button>
        </EditForm>

        <div class="divider">
            <span>¿No tienes una cuenta?</span>
        </div>

        <div class="footer-link">
            <a href="/registro">Regístrate aquí</a>
        </div>
    </div>
</div>

<style>
    /* Estilos fieles al mockup */
    .auth-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        background-color: #f8f9fa; /* Fondo gris claro */
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .auth-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        width: 100%;
        max-width: 400px;
        text-align: center;
    }

    .icon-container {
        font-size: 40px;
        margin-bottom: 10px;
    }

    .title {
        font-size: 24px;
        font-weight: 800;
        color: #1a202c;
        margin-bottom: 5px;
    }

    .subtitle {
        color: #718096;
        font-size: 14px;
        margin-bottom: 30px;
    }

    .form-group {
        text-align: left;
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #2d3748;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-sizing: border-box;
        font-size: 14px;
        transition: border-color 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #8b5cf6;
    }

    .forgot-password {
        text-align: right;
        margin-bottom: 24px;
    }

    .forgot-password a, .footer-link a {
        color: #8b5cf6;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }

    .btn-primary-custom {
        width: 100%;
        padding: 14px;
        background-color: #8b5cf6; /* Púrpura del mockup */
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-primary-custom:hover {
        background-color: #7c3aed;
    }
    
    .btn-primary-custom:disabled {
        background-color: #c4b5fd;
        cursor: not-allowed;
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 30px 0;
        color: #a0aec0;
        font-size: 14px;
    }

    .divider::before, .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #e2e8f0;
    }

    .divider span {
        padding: 0 10px;
    }

    .error-message {
        background-color: #fed7d7;
        color: #c53030;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }
</style>

@code {
    private Votify.Application.DTOs.LoginRequestDto loginModel = new Votify.Application.DTOs.LoginRequestDto { Email = "", Password = "" };
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        var response = await AuthService.LoginAsync(loginModel);

        if (response.IsSuccess)
        {
            NavigationManager.NavigateTo("/"); // Redirige al inicio si tiene éxito
        }
        else
        {
            errorMessage = response.Message;
        }

        isLoading = false;
    }
}
