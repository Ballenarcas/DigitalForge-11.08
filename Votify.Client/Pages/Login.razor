@page "/login"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<!-- OVERLAY DE EXITO EPICO -->
@if (showSuccess)
{
    <div class="auth-success-overlay" id="loginSuccessOverlay">
        <div class="success-checkmark">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 6L9 17l-5-5" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <div class="success-text">¡Bienvenido de vuelta!</div>
        <div class="success-sub">Entrando a Votify...</div>
        <!-- Particulas de exito -->
        @for (int i = 0; i < 20; i++)
        {
            var tx = (i % 5 - 2) * 80 + "px";
            var ty = (i % 3 - 1) * 80 + "px";
            var delay = i * 0.05;
            <div class="success-particle" style="--tx:@tx; --ty:@ty; animation: success-particle-blast 0.8s ease-out forwards @delay;s;"></div>
        }
    </div>
}

<div class="auth-wrapper">
    <div class="auth-card @(shakeError ? "error-shake-hard" : "")">
        <div class="icon-container">
            <svg viewBox="0 0 24 24" fill="none" width="48" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 8v4m0 4v.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h1 class="title">Bienvenido a Votify</h1>
        <p class="subtitle">Inicia sesión para continuar</p>

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }

            <div class="form-group">
                <label>Correo Electrónico</label>
                <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="ejemplo@correo.com" />
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="••••••••" />
            </div>

            <div class="forgot-password">
                <a href="#">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn-primary-custom @(isLoading ? "loading-pulse" : "")" disabled="@isLoading">
                @if(isLoading) { <span class="btn-spinner"></span> <span>Entrando...</span> } else { <span>Iniciar Sesión</span> }
            </button>
        </EditForm>

        <div class="divider">
            <span>¿No tienes una cuenta?</span>
        </div>

        <div class="footer-link">
            <a href="/registro">Regístrate aquí</a>
        </div>
    </div>
</div>

<style>
    .auth-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .auth-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        width: 100%;
        max-width: 400px;
        text-align: center;
        animation: card-fade-in 0.6s ease-out;
    }

    @@keyframes card-fade-in {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .icon-container {
        font-size: 40px;
        margin-bottom: 10px;
        color: #8b5cf6;
        animation: icon-pop 0.5s ease-out 0.2s both;
    }

    @@keyframes icon-pop {
        from { transform: scale(0.5); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .title {
        font-size: 24px;
        font-weight: 800;
        color: #1a202c;
        margin-bottom: 5px;
        animation: fade-in-up 0.5s ease-out 0.3s both;
    }

    .subtitle {
        color: #718096;
        font-size: 14px;
        margin-bottom: 30px;
        animation: fade-in-up 0.5s ease-out 0.4s both;
    }

    @@keyframes fade-in-up {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-group {
        text-align: left;
        margin-bottom: 20px;
        animation: fade-in-up 0.4s ease-out both;
    }

    .form-group:nth-of-type(1) { animation-delay: 0.5s; }
    .form-group:nth-of-type(2) { animation-delay: 0.6s; }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #2d3748;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-sizing: border-box;
        font-size: 14px;
        transition: all 0.3s ease;
        background: white;
    }

    .form-control:focus {
        outline: none;
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
    }

    .form-control:hover:not(:focus) {
        border-color: #cbd5e1;
    }

    .forgot-password {
        text-align: right;
        margin-bottom: 24px;
        animation: fade-in-up 0.4s ease-out 0.7s both;
    }

    .forgot-password a, .footer-link a {
        color: #8b5cf6;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: color 0.2s;
    }

    .forgot-password a:hover, .footer-link a:hover {
        color: #7c3aed;
        text-decoration: underline;
    }

    .btn-primary-custom {
        width: 100%;
        padding: 14px;
        background-color: #8b5cf6;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.25s ease;
        animation: fade-in-up 0.4s ease-out 0.8s both;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-primary-custom:hover:not(:disabled) {
        background-color: #7c3aed;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3);
    }

    .btn-primary-custom:active:not(:disabled) {
        transform: translateY(0) scale(0.98);
    }
    
    .btn-primary-custom:disabled {
        background-color: #c4b5fd;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .btn-spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 30px 0;
        color: #a0aec0;
        font-size: 14px;
        animation: fade-in 0.4s ease-out 0.9s both;
    }

    @@keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .divider::before, .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #e2e8f0;
    }

    .divider span {
        padding: 0 10px;
    }

    .footer-link {
        animation: fade-in 0.4s ease-out 1.0s both;
    }

    .error-message {
        background-color: #fed7d7;
        color: #c53030;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        animation: error-shake 0.4s ease-in-out;
    }

    @@keyframes error-shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        50% { transform: translateX(6px); }
        75% { transform: translateX(-3px); }
    }
</style>

@code {
    private Votify.Application.DTOs.LoginRequestDto loginModel = new Votify.Application.DTOs.LoginRequestDto { Email = "", Password = "" };
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private bool showSuccess = false;
    private bool shakeError = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;
        shakeError = false;

        if (string.IsNullOrWhiteSpace(loginModel.Email) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Por favor, completa todos los campos.";
            TriggerErrorShake();
            isLoading = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(loginModel.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            errorMessage = "El formato del correo electrónico no es válido.";
            TriggerErrorShake();
            isLoading = false;
            return;
        }

        var response = await AuthService.LoginAsync(loginModel);

        if (response.IsSuccess)
        {
            showSuccess = true;
            StateHasChanged();
            // Esperar 1.8s para que se vea la animacion epica
            await Task.Delay(1800);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            errorMessage = response.Message;
            TriggerErrorShake();
        }

        isLoading = false;
    }

    private void TriggerErrorShake()
    {
        shakeError = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(600);
            await InvokeAsync(() =>
            {
                shakeError = false;
                StateHasChanged();
            });
        });
    }
}
