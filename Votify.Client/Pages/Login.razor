@page "/login"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="auth-epic-wrapper">
    <!-- Orbes de luz flotantes -->
    <div class="auth-orb orb-1"></div>
    <div class="auth-orb orb-2"></div>
    <div class="auth-orb orb-3"></div>

    <!-- Particulas sutiles -->
    @for (int i = 0; i < 20; i++)
    {
        var left = (i * 5.3) % 100;
        var duration = 10 + (i % 8);
        var delay = i * 0.4;
        var size = 2 + (i % 3);
        <div class="auth-particle" style="left:@(left)%; width:@(size)px; height:@(size)px; animation-duration:@(duration)s; animation-delay:@(delay)s;"></div>
    }

    <div class="auth-epic-card">
        <div class="auth-icon">
            <svg viewBox="0 0 24 24" fill="none" width="32" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="7" r="4" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <h1 class="auth-title">Bienvenido a Votify</h1>
        <p class="auth-subtitle">Inicia sesión para continuar</p>

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-error">@errorMessage</div>
            }

            <div class="auth-form-group">
                <label>Correo Electrónico</label>
                <InputText @bind-Value="loginModel.Email" class="auth-input" placeholder="ejemplo@correo.com" />
            </div>

            <div class="auth-form-group">
                <label>Contraseña</label>
                <InputText @bind-Value="loginModel.Password" type="password" class="auth-input" placeholder="••••••••" />
            </div>

            <div class="auth-forgot">
                <a href="#">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="auth-btn-primary" disabled="@isLoading">
                @if(isLoading)
                {
                    <span class="btn-spinner"></span>
                    <span>Iniciando sesión...</span>
                }
                else
                {
                    <span>Iniciar Sesión</span>
                }
            </button>
        </EditForm>

        <div class="auth-divider">
            <span>¿No tienes una cuenta?</span>
        </div>

        <div class="auth-footer">
            <a href="/registro">Regístrate aquí</a>
        </div>
    </div>
</div>

<style>
    /* Reset local para no heredar estilos antiguos */
    :scope { all: initial; }
</style>

@code {
    private Votify.Application.DTOs.LoginRequestDto loginModel = new Votify.Application.DTOs.LoginRequestDto { Email = "", Password = "" };
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(loginModel.Email) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Por favor, completa todos los campos.";
            isLoading = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(loginModel.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            errorMessage = "El formato del correo electrónico no es válido.";
            isLoading = false;
            return;
        }

        var response = await AuthService.LoginAsync(loginModel);

        if (response.IsSuccess)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            errorMessage = response.Message;
        }

        isLoading = false;
    }
}
