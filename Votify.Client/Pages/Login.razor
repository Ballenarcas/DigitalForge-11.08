@page "/login"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<!-- OVERLAY DE EXITO EPICO -->
@if (showSuccess)
{
    <div class="auth-success-overlay" id="loginSuccessOverlay">
        @for (int i = 0; i < 3; i++)
        {
            <div class="glow-ring" style="animation-delay: @(i * 0.6)s;"></div>
        }
        <div class="success-circle">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <div class="success-text">¡Bienvenido de nuevo!</div>
        <div class="success-sub">Entrando a Votify...</div>
        @for (int i = 0; i < 30; i++)
        {
            var tx = (i % 7 - 3) * 150;
            var ty = (i % 5 - 2) * 150;
            var delay = i * 0.03;
            var colors = new[] { "#e94560", "#533483", "#0f3460", "#16213e", "#ffffff" };
            var color = colors[i % colors.Length];
            var size = 8 + (i % 8);
            <div class="success-particle" style="--tx: @(tx)px; --ty: @(ty)px; animation-delay: @(delay)s; background: @color; width: @(size)px; height: @(size)px; box-shadow: 0 0 10px @color;"></div>
        }
    </div>
}

<div class="auth-wrapper">
    <div class="auth-card @(shakeError ? "error-shake-hard" : "")">
        <div class="icon-container">
            <svg viewBox="0 0 24 24" fill="none" width="48" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M12 8v4m0 4v.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h1 class="title">Bienvenido a Votify</h1>
        <p class="subtitle">Inicia sesión para continuar</p>

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }

            <div class="form-group">
                <label>Correo Electrónico</label>
                <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="ejemplo@correo.com" />
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="••••••••" />
            </div>

            <div class="forgot-password">
                <a href="#">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn-primary-custom @(isLoading ? "loading-pulse" : "")" disabled="@isLoading">
                @if(isLoading) { <span class="btn-spinner"></span> <span>Entrando...</span> } else { <span>Iniciar Sesión</span> }
            </button>
        </EditForm>

        <div class="divider">
            <span>¿No tienes una cuenta?</span>
        </div>

        <div class="footer-link">
            <a href="registro">Regístrate aquí</a>
        </div>
    </div>
</div>

<style>
    .auth-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .auth-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        width: 100%;
        max-width: 400px;
        text-align: center;
        animation: card-fade-in 0.6s ease-out;
    }

    .auth-success-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 25%, #0f3460 50%, #533483 75%, #e94560 100%);
        background-size: 400% 400%;
        animation: gradient-shift 3s ease infinite;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        overflow: hidden;
    }

    @@keyframes gradient-shift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .auth-success-overlay::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 50%);
        animation: pulse-glow 2s ease-in-out infinite;
    }

    @@keyframes pulse-glow {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }

    .success-circle {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background: linear-gradient(145deg, #ffffff 0%, #f0f0f0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 
            0 0 60px rgba(233, 69, 96, 0.5),
            0 0 100px rgba(83, 52, 131, 0.3),
            inset 0 -5px 20px rgba(0,0,0,0.1);
        animation: epic-pop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        position: relative;
        z-index: 2;
    }

    @@keyframes epic-pop {
        0% { transform: scale(0) rotate(-180deg); opacity: 0; }
        60% { transform: scale(1.3) rotate(10deg); }
        80% { transform: scale(0.9) rotate(-5deg); }
        100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }

    .success-circle svg {
        width: 80px;
        height: 80px;
        stroke: #e94560;
        stroke-width: 4;
        fill: none;
        stroke-dasharray: 200;
        stroke-dashoffset: 200;
        animation: draw-check 0.8s ease-out 0.5s forwards;
        filter: drop-shadow(0 4px 8px rgba(233, 69, 96, 0.5));
    }

    @@keyframes draw-check {
        to { stroke-dashoffset: 0; }
    }

    .success-text {
        color: white;
        font-size: 42px;
        font-weight: 900;
        margin-top: 40px;
        text-shadow: 
            0 0 20px rgba(233, 69, 96, 0.8),
            0 0 40px rgba(233, 69, 96, 0.5),
            0 4px 8px rgba(0,0,0,0.3);
        animation: text-bounce 0.6s ease-out 0.8s both;
        letter-spacing: -1px;
        position: relative;
        z-index: 2;
    }

    @@keyframes text-bounce {
        0% { opacity: 0; transform: scale(0.5) translateY(40px); }
        60% { transform: scale(1.1) translateY(-10px); }
        80% { transform: scale(0.95) translateY(5px); }
        100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    .success-sub {
        color: rgba(255,255,255,0.9);
        font-size: 20px;
        margin-top: 12px;
        font-weight: 500;
        letter-spacing: 1px;
        animation: fade-up 0.5s ease-out 1s both;
        position: relative;
        z-index: 2;
    }

    @@keyframes fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .success-particle {
        position: absolute;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        animation: particle-explode 1.2s ease-out forwards;
        top: 50%;
        left: 50%;
    }

    @@keyframes particle-explode {
        0% { 
            transform: translate(-50%, -50%) scale(1); 
            opacity: 1; 
        }
        100% { 
            transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(0);
            opacity: 0; 
        }
    }

    .success-sparkle {
        position: absolute;
        width: 6px;
        height: 6px;
        background: white;
        border-radius: 50%;
        animation: sparkle 1.5s ease-in-out infinite;
        box-shadow: 0 0 10px white, 0 0 20px white;
    }

    @@keyframes sparkle {
        0%, 100% { opacity: 0; transform: scale(0); }
        50% { opacity: 1; transform: scale(1); }
    }

    .confetti {
        position: absolute;
        width: 10px;
        height: 10px;
        animation: confetti-fall 3s ease-in-out infinite;
    }

    @@keyframes confetti-fall {
        0% { transform: translateY(-100vh) rotate(0deg); opacity: 1; }
        100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
    }

    .glow-ring {
        position: absolute;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        border: 3px solid rgba(233, 69, 96, 0.3);
        animation: ring-expand 2s ease-out infinite;
    }

    @@keyframes ring-expand {
        0% { transform: scale(0.8); opacity: 1; }
        100% { transform: scale(2); opacity: 0; }
    }

    @@keyframes card-fade-in {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .icon-container {
        font-size: 40px;
        margin-bottom: 10px;
        color: #8b5cf6;
        animation: icon-pop 0.5s ease-out 0.2s both;
    }

    @@keyframes icon-pop {
        from { transform: scale(0.5); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .title {
        font-size: 24px;
        font-weight: 800;
        color: #1a202c;
        margin-bottom: 5px;
        animation: fade-in-up 0.5s ease-out 0.3s both;
    }

    .subtitle {
        color: #718096;
        font-size: 14px;
        margin-bottom: 30px;
        animation: fade-in-up 0.5s ease-out 0.4s both;
    }

    @@keyframes fade-in-up {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-group {
        text-align: left;
        margin-bottom: 20px;
        animation: fade-in-up 0.4s ease-out both;
    }

    .form-group:nth-of-type(1) { animation-delay: 0.5s; }
    .form-group:nth-of-type(2) { animation-delay: 0.6s; }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #2d3748;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-sizing: border-box;
        font-size: 14px;
        transition: all 0.3s ease;
        background: white;
    }

    .form-control:focus {
        outline: none;
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
    }

    .form-control:hover:not(:focus) {
        border-color: #cbd5e1;
    }

    .forgot-password {
        text-align: right;
        margin-bottom: 24px;
        animation: fade-in-up 0.4s ease-out 0.7s both;
    }

    .forgot-password a, .footer-link a {
        color: #8b5cf6;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: color 0.2s;
    }

    .forgot-password a:hover, .footer-link a:hover {
        color: #7c3aed;
        text-decoration: underline;
    }

    .btn-primary-custom {
        width: 100%;
        padding: 14px;
        background-color: #8b5cf6;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.25s ease;
        animation: fade-in-up 0.4s ease-out 0.8s both;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-primary-custom:hover:not(:disabled) {
        background-color: #7c3aed;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3);
    }

    .btn-primary-custom:active:not(:disabled) {
        transform: translateY(0) scale(0.98);
    }
    
    .btn-primary-custom:disabled {
        background-color: #c4b5fd;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .btn-spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 30px 0;
        color: #a0aec0;
        font-size: 14px;
        animation: fade-in 0.4s ease-out 0.9s both;
    }

    @@keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .divider::before, .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #e2e8f0;
    }

    .divider span {
        padding: 0 10px;
    }

    .footer-link {
        animation: fade-in 0.4s ease-out 1.0s both;
    }

    .error-message {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        color: #7f1d1d;
        border: 1.5px solid #fca5a5;
        border-left: 4px solid #ef4444;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        animation: slideInAlert 0.4s cubic-bezier(0.22, 1, 0.36, 1) both, subtleShake 0.5s ease-out;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.15);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .error-message::before {
        content: '⚠';
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ef4444;
        color: white;
        border-radius: 50%;
        font-weight: 800;
        font-size: 0.85rem;
    }

    @@keyframes slideInAlert {
        from { 
            opacity: 0; 
            transform: translateX(-10px); 
        }
        to { 
            opacity: 1; 
            transform: translateX(0); 
        }
    }

    @@keyframes subtleShake {
        0%, 100% { transform: translateX(0); }
        10%, 30%, 50%, 70%, 90% { transform: translateX(-1px); }
        20%, 40%, 60%, 80% { transform: translateX(1px); }
    }

    @@keyframes error-shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        50% { transform: translateX(6px); }
        75% { transform: translateX(-3px); }
    }
    }
</style>

@code {
    private Votify.Application.DTOs.LoginRequestDto loginModel = new Votify.Application.DTOs.LoginRequestDto { Email = "", Password = "" };
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private bool showSuccess = false;
    private bool shakeError = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;
        shakeError = false;

        if (string.IsNullOrWhiteSpace(loginModel.Email) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Por favor, completa todos los campos.";
            TriggerErrorShake();
            isLoading = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(loginModel.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            errorMessage = "El formato del correo electrónico no es válido.";
            TriggerErrorShake();
            isLoading = false;
            return;
        }

        var response = await AuthService.LoginAsync(loginModel);

        if (response.IsSuccess)
        {
            showSuccess = true;
            StateHasChanged();
            // Esperar 1.8s para que se vea la animacion epica
            await Task.Delay(1800);
            NavigationManager.NavigateTo("");
        }
        else
        {
            errorMessage = response.Message;
            TriggerErrorShake();
        }

        isLoading = false;
    }

    private void TriggerErrorShake()
    {
        shakeError = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(600);
            await InvokeAsync(() =>
            {
                shakeError = false;
                StateHasChanged();
            });
        });
    }
}
