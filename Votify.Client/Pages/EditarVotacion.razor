@code {
    [Parameter]
    public string Id { get; set; } = default!;

    string Nombre = "";
    string Tipo = "ESTANDAR";
    DateTime FechaInicio = DateTime.Now;
    DateTime FechaFin = DateTime.Now.AddDays(1);
    int LimiteProy = 1;
    bool Comentarios = true;
    bool ComentariosObligatorios = false;
    bool EsAnonima = false;
    int Estado = 0;
    string EventoId = "";
    string? Mensaje;
    List<CriterioDto> Criterios = new();

    bool cargando = true;
    bool errorCarga = false;
    bool guardando = false;
    bool eliminando = false;
    bool mostrarModalConfirmacion = false;
    bool mostrarModalConfirmacionFinalizar = false;
    bool cambiandoEstado = false;
    int EstadoActual = 0;
    
    DateTime FechaInicioOriginal = DateTime.Now;
    DateTime FechaFinOriginal = DateTime.Now.AddDays(1);
    
    bool YaInicio    => DateTime.Now >= FechaInicioOriginal;
    bool YaFinalizo  => DateTime.Now >= FechaFinOriginal;
    bool EsMulticriterio => Tipo == "MULTICRITERIO" || Tipo == "MULTICRITERIO_PUBLICO";
    decimal PesoTotal => Criterios.Sum(c => c.Peso);
    bool PesosValidos => Criterios.Count > 0
        && Criterios.All(c => !string.IsNullOrWhiteSpace(c.Nombre) && c.Peso > 0)
        && Math.Abs(PesoTotal - 100m) <= 0.01m;

    protected override async Task OnInitializedAsync()
    {
        await CargarVotacion();
    }

    async Task CargarVotacion()
    {
        cargando = true;
        errorCarga = false;
        try
        {
            var votacion = await VotacionesService.ObtenerVotacion(Id);
            if (votacion is null)
            {
                errorCarga = true;
                return;
            }
            Nombre             = votacion.Nombre;
            Tipo               = votacion.Tipo?.ToUpper() == "RECUENTO DE VOTOS" ? "ESTANDAR" : (votacion.Tipo?.ToUpper() ?? "ESTANDAR");
            FechaInicio        = votacion.FechaInicio.ToLocalTime();
            FechaFin           = votacion.FechaFin.ToLocalTime();
            FechaInicioOriginal = votacion.FechaInicio.ToLocalTime();
            FechaFinOriginal    = votacion.FechaFin.ToLocalTime();
            LimiteProy    = votacion.LimiteProy;
            Comentarios = votacion.Comentarios;
            ComentariosObligatorios = votacion.ComentariosObligatorios;
            EsAnonima = votacion.EsAnonima;
            EventoId = votacion.EventoId;
            Estado = votacion.Estado;
            EstadoActual = votacion.Estado;
            Criterios = votacion.Criterios?.Any() == true
                ? votacion.Criterios
                : new List<CriterioDto>
                {
                    new CriterioDto { Nombre = "Innovación", Peso = 40 },
                    new CriterioDto { Nombre = "Diseño", Peso = 60 }
                };
        }
        catch
        {
            errorCarga = true;
        }
        finally
        {
            cargando = false;
        }
    }

    async Task HandleGuardar()
    {
        if (string.IsNullOrWhiteSpace(Nombre))
        {
            Mensaje = "El título de la votación es obligatorio.";
            return;
        }
        if (FechaFin <= FechaInicio)
        {
            Mensaje = "Error: La fecha de fin debe ser posterior a la de inicio.";
            return;
        }
        if (EsMulticriterio && !PesosValidos)
        {
            Mensaje = "Error: Los pesos de los criterios deben sumar 100%.";
            return;
        }

        guardando = true;
        Mensaje   = null;
        try
        {
            var request = new VotacionDto
            {
                Id                = Id,
                Nombre            = Nombre,
                Tipo              = Tipo,
                FechaInicio       = FechaInicio.ToUniversalTime(),
                FechaFin          = FechaFin.ToUniversalTime(),
                LimiteProy        = LimiteProy,
                Comentarios       = Comentarios,
                ComentariosObligatorios = ComentariosObligatorios,
                EsAnonima         = EsAnonima,
                EventoId          = EventoId,
                Estado            = EstadoActual,
                Criterios         = EsMulticriterio ? Criterios : new List<CriterioDto>()
            };
            await VotacionesService.ActualizarVotacion(Id, request);
            Mensaje = "Votación actualizada correctamente.";
            StateHasChanged();
            await Task.Delay(800);
            Nav.NavigateTo($"/votaciones?eventoId={EventoId}");
        }
        catch
        {
            Mensaje = "Error al guardar los cambios. Inténtalo de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }

    void HandleEliminar()
    {
        mostrarModalConfirmacion = true;
    }

    async Task ConfirmarEliminar()
    {
        eliminando = true;
        Mensaje = null;
        try
        {
            await VotacionesService.EliminarVotacion(Id);
            Mensaje = "Votación eliminada correctamente.";
            StateHasChanged();
            await Task.Delay(800);
            Nav.NavigateTo($"/votaciones?eventoId={EventoId}");
        }
        catch
        {
            Mensaje = "Error al eliminar la votación. Inténtalo de nuevo.";
            mostrarModalConfirmacion = false;
        }
        finally
        {
            eliminando = false;
        }
    }

    void CerrarModal()
    {
        mostrarModalConfirmacion = false;
    }

    private void AgregarCriterio() => Criterios.Add(new CriterioDto { Nombre = "", Peso = 0 });
    private void QuitarCriterio(CriterioDto criterio)
    {
        if (Criterios.Count > 1)
        {
            Criterios.Remove(criterio);
        }
    }

    async Task PausarVotacion()
    {
        cambiandoEstado = true;
        Mensaje = null;
        try
        {
            Console.WriteLine($"[DEBUG] Intentando pausar votación {Id}. Estado actual: {EstadoActual}");
            await VotacionesService.PausarVotacion(Id);
            Console.WriteLine($"[DEBUG] Pausa exitosa. Actualizando UI a estado 1 (Pausada)");
            Estado = 1;
            EstadoActual = 1;
            Mensaje = "✅ Votación pausada correctamente.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Exception al pausar: {ex.Message}");
            var msg = ex.Message;
            if (msg.Contains("\"error\":"))
                msg = System.Text.RegularExpressions.Regex.Match(msg, "\"error\":\"(.*?)\"", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Groups[1].Value;
            Mensaje = $"❌ Error al pausar: {msg}";
        }
        finally
        {
            cambiandoEstado = false;
        }
    }

    void MostrarConfirmacionFinalizar()
    {
        mostrarModalConfirmacionFinalizar = true;
    }

    void CerrarModalFinalizar()
    {
        mostrarModalConfirmacionFinalizar = false;
    }

    async Task ConfirmarDetenerVotacion()
    {
        cambiandoEstado = true;
        Mensaje = null;
        try
        {
            await VotacionesService.DetenerVotacion(Id);
            Estado = 2;
            EstadoActual = 2;
            Mensaje = "✅ Votación finalizada correctamente.";
            mostrarModalConfirmacionFinalizar = false;
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            if (msg.Contains("\"Error\""))
                msg = System.Text.RegularExpressions.Regex.Match(msg, "\"Error\":\"(.*?)\"").Groups[1].Value;
            Mensaje = $"❌ Error al finalizar: {(string.IsNullOrEmpty(msg) ? ex.Message : msg)}";
        }
        finally
        {
            cambiandoEstado = false;
        }
    }

    async Task AbrirVotacion()
    {
        cambiandoEstado = true;
        Mensaje = null;
        try
        {
            Console.WriteLine($"[DEBUG] Intentando abrir/reanudar votación {Id}. Estado actual: {EstadoActual}");
            await VotacionesService.AbrirVotacion(Id);
            Console.WriteLine($"[DEBUG] Reactivación exitosa. Actualizando UI a estado 0 (Activa)");
            Estado = 0;
            EstadoActual = 0;
            Mensaje = "✅ Votación reabierta correctamente.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Exception al reabrir: {ex.Message}");
            var msg = ex.Message;
            if (msg.Contains("\"error\":"))
                msg = System.Text.RegularExpressions.Regex.Match(msg, "\"error\":\"(.*?)\"", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Groups[1].Value;
            Mensaje = $"❌ Error al reabrir: {msg}";
        }
        finally
        {
            cambiandoEstado = false;
        }
    }

    void HandleVolver() => Nav.NavigateTo($"/votaciones?eventoId={EventoId}");
}
