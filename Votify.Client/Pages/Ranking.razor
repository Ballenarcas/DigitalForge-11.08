    }

    .ranking-panel {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        border: 1px solid #f1f5f9;
    }

    .ranking-panel h3 {
        font-size: 1rem;
        font-weight: 600;
        color: #1a1a1a;
        margin: 0 0 0.5rem;
    }

    .subtitle {
        font-size: 0.85rem;
        color: #94a3b8;
        margin: 0 0 1rem;
    }

    .placeholder-text {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
        font-size: 1rem;
    }

    .proyecto-info {
        background: linear-gradient(135deg, #f3e8ff 0%, #ede9fe 100%);
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .proyecto-info h4 {
        margin: 0 0 0.25rem;
        color: #6b21a8;
        font-size: 1rem;
    }

    .equipo-info {
        margin: 0;
        color: #7c3aed;
        font-size: 0.85rem;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .ranking-table {
        width: 100%;
        border-collapse: collapse;
    }

    .ranking-table thead {
        border-bottom: 1px solid #f1f5f9;
    }

    .ranking-table th {
        text-align: left;
        padding: 0.75rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .table-row {
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s;
        cursor: pointer;
    }

    .table-row:hover {
        background-color: #f8fafc;
    }

    .table-row.selected {
        background-color: #e0d7f6;
    }

    .ranking-table td {
        padding: 0.75rem 0.5rem;
        vertical-align: middle;
        font-size: 0.9rem;
    }

    .col-pos {
        width: 50px;
    }

    .col-proyecto {
        flex: 1;
        font-weight: 500;
        color: #1e293b;
    }

    .col-equipo {
        width: 100px;
        color: #64748b;
    }

    .col-votos {
        width: 60px;
        text-align: center;
        font-weight: 600;
        color: #9333ea;
    }

    .col-manual {
        width: 80px;
    }

    .pos-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #f3e8ff 0%, #ede9fe 100%);
        color: #9333ea;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-auto {
        background: #f1f5f9;
        color: #64748b;
    }

    .badge-manual {
        background: #fce7f3;
        color: #be185d;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        font-size: 0.9rem;
        font-weight: 500;
        color: #1a1a1a;
        margin-bottom: 0.5rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.9rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #a855f7;
        box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.1);
    }

    textarea.form-control {
        resize: vertical;
        min-height: 80px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .btn-guardar {
        width: 100%;
        padding: 0.75rem;
        background: linear-gradient(135deg, #a855f7 0%, #d946ef 100%);
