        border-color: #ddd6fe;
        color: #7c3aed;
    }

    .page-header-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        max-width: 1400px;
        margin-left: auto;
        margin-right: auto;
    }

    .logo-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
    }

    .brand-name {
        font-weight: 800;
        font-size: 1.5rem;
        color: #4c1d95;
        letter-spacing: -0.02em;
    }

    .content-wrapper {
        max-width: 1400px;
        margin: 0 auto;
    }

    .ranking-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
