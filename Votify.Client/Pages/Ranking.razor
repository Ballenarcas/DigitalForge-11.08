        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        margin-bottom: 1rem;
    }

    .btn-guardar:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(168, 85, 247, 0.3);
    }

    .btn-guardar:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-guardar-justificacion {
        width: 100%;
        padding: 0.6rem;
        background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }

    .btn-guardar-justificacion:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(15, 118, 110, 0.3);
