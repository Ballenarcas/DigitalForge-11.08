    }

    .loader-container {
        text-align: center;
        padding: 4rem;
        color: #64748b;
    }

    .spinner {
        width: 35px;
        height: 35px;
        border: 4px solid #f3e8ff;
        border-top: 4px solid #9333ea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 1rem;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 1024px) {
        .ranking-container {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    [Parameter]
    public string VotacionId { get; set; } = string.Empty;

    private List<ResultadoProyectoDto>? listaResultados;
    private bool isAuthorized = false;
    private bool guardando = false;
    private bool guardandoJustificacion = false;
    private string? selectedProyectoId = null;
    private string? selectedProyectoNombre = null;
    private string? selectedProyectoEquipo = null;
    private int posicionFinal = 1;
    private int votosAsignados = 0;
    private string? textoJustificacion = null;
    private JustificacionDto? justificacionActual = null;
    private string? mensajeExito = null;
    private string? mensajeError = null;
    private string? mensajeJustificacion = null;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(VotacionId))
            return;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity?.IsAuthenticated ?? false)
                return;

            var votacion = await VotacionesService.ObtenerVotacion(VotacionId);
            if (votacion == null)
                return;

            var rol = await EventosService.ObtenerRolEnEvento(votacion.EventoId);
            isAuthorized = EsOrganizador(rol);

            if (!isAuthorized)
                return;

            await CargarResultados();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task CargarResultados()
    {
        try
        {
            listaResultados = await VotacionesService.ObtenerResultados(VotacionId);
        }
        catch (Exception ex)
        {
            var errorMsg = ErrorMessageParser.ExtractErrorMessage(ex.Message);
            Console.WriteLine($"Error cargando resultados: {errorMsg}");
            listaResultados = new List<ResultadoProyectoDto>();
        }
    }

    private async Task SelectProyecto(ResultadoProyectoDto resultado)
    {
        selectedProyectoId = resultado.Id;
        selectedProyectoNombre = resultado.Nombre;
        selectedProyectoEquipo = resultado.Equipo;
        textoJustificacion = null;
        mensajeExito = null;
        mensajeError = null;
        mensajeJustificacion = null;

        try
        {
            var asignacionesManuales = await VotacionesService.ObtenerAsignacionesManuales(VotacionId);
            var asignacionExistente = asignacionesManuales?.FirstOrDefault(a => a.Id == resultado.Id);

            if (asignacionExistente != null)
            {
                posicionFinal = asignacionExistente.Posicion;
                votosAsignados = asignacionExistente.TotalVotos;
            }
            else
            {
                posicionFinal = resultado.Posicion;
                votosAsignados = resultado.TotalVotos;
            }

            justificacionActual = await VotacionesService.ObtenerJustificacion(VotacionId, resultado.Id);
        }
        catch (Exception ex)
        {
            posicionFinal = resultado.Posicion;
            votosAsignados = resultado.TotalVotos;
            Console.WriteLine($"Error cargando datos del proyecto: {ex.Message}");
            justificacionActual = null;
        }
    }

    private async Task GuardarAsignacion()
    {
        if (string.IsNullOrEmpty(selectedProyectoId))
        {
            mensajeError = "Debes seleccionar un proyecto";
            return;
        }

        if (posicionFinal <= 0)
        {
            mensajeError = "La posición debe ser mayor a 0";
            return;
        }

        guardando = true;
        mensajeExito = null;
        mensajeError = null;

        try
        {
            var dto = new AsignacionManualVotosDto
            {
                ProyectoId = selectedProyectoId,
                PosicionFinal = posicionFinal,
                VotosAsignados = votosAsignados,
                Justificacion = textoJustificacion?.Trim()
            };

            await VotacionesService.GuardarAsignacionManual(VotacionId, dto);
            mensajeExito = "Asignación manual guardada correctamente.";
            await CargarResultados();
        }
        catch (Exception ex)
        {
            mensajeError = ErrorMessageParser.ExtractErrorMessage(ex.Message);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task GuardarJustificacion()
    {
        if (string.IsNullOrEmpty(selectedProyectoId) || string.IsNullOrEmpty(textoJustificacion?.Trim()))
        {
            mensajeError = "Debes escribir una justificación";
            return;
        }

        guardandoJustificacion = true;
        mensajeJustificacion = null;

        try
        {
            var dto = new GuardarJustificacionDto
            {
                ProyectoId = selectedProyectoId,
                TextoJustificacion = textoJustificacion.Trim()
            };

            await VotacionesService.GuardarJustificacion(VotacionId, dto);
            mensajeJustificacion = "Comentario guardado correctamente.";
            textoJustificacion = null;

            // Recargar justificación
            justificacionActual = await VotacionesService.ObtenerJustificacion(VotacionId, selectedProyectoId);
        }
        catch (Exception ex)
        {
            mensajeError = ErrorMessageParser.ExtractErrorMessage(ex.Message);
        }
        finally
        {
            guardandoJustificacion = false;
        }
    }

    private void VolverAVotaciones()
    {
        Nav.NavigateTo($"/votaciones?eventoId={AppState.EventoId}");
    }

    private static bool EsOrganizador(string? rol)
    {
        return string.Equals(rol?.Trim(), "ORGANIZADOR", StringComparison.OrdinalIgnoreCase)
            || string.Equals(rol?.Trim(), "Organizador", StringComparison.OrdinalIgnoreCase);
    }
}
