    }

    .comentario-rol {
        background: #e0d7f6;
        color: #6b21a8;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .comentario-fecha {
        color: #94a3b8;
        font-size: 0.8rem;
    }

    .comentario-texto {
        color: #475569;
        font-size: 0.9rem;
        line-height: 1.4;
        margin-bottom: 0.5rem;
