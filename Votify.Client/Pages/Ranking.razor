@page "/votacion/{VotacionId}/editar-votos"
@using Votify.Client.DTOs
@using Votify.Client.Utilities
@inject Votify.Client.Services.VotacionesService VotacionesService
@inject Votify.Client.Services.EventosService EventosService
@inject NavigationManager Nav
@inject Votify.Client.Services.AppState AppState
@inject AuthenticationStateProvider AuthStateProvider

<div class="main-container">
    <div class="header-principal">
        <button class="btn-volver" @onclick="VolverAVotaciones">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                <path d="M15 19L8 12L15 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Volver
        </button>
    </div>

    <div class="page-header-row">
        <div class="logo-icon small">
            <span style="font-size: 1.5rem;">📊</span>
        </div>
        <span class="brand-name">Ranking</span>
    </div>

    <div class="content-wrapper">
        @if (!isAuthorized)
        {
            <div class="error-message">
                No tienes permisos para acceder a esta página. Solo los ORGANIZADORES pueden editar votos.
            </div>
        }
        else if (listaResultados == null)
        {
            <div class="loader-container">
                <div class="spinner"></div>
                <p>Cargando resultados...</p>
            </div>
        }
        else if (listaResultados.Count == 0)
        {
            <div class="empty-state">
                <p>No hay resultados disponibles para esta votación.</p>
            </div>
        }
        else
        {
            <div class="ranking-container">
                <!-- Panel Izquierdo: Tabla de Resultados -->
                <div class="ranking-panel resultado-actual">
                    <h3>Resultado actual</h3>
                    <p class="subtitle">Haz clic en un proyecto para editarlo</p>
                    <div class="table-wrapper">
                        <table class="ranking-table">
                            <thead>
                                <tr>
                                    <th class="col-pos">POS.</th>
                                    <th class="col-proyecto">PROYECTO</th>
                                    <th class="col-equipo">EQUIPO</th>
                                    <th class="col-votos">VOTOS</th>
                                    <th class="col-manual">MANUAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var resultado in listaResultados.OrderBy(r => r.Posicion))
                                {
                                    <tr class="table-row @(selectedProyectoId == resultado.Id ? "selected" : "")" @onclick="() => SelectProyecto(resultado)">
                                        <td class="col-pos">
                                            <span class="pos-badge">@resultado.Posicion</span>
                                        </td>
                                        <td class="col-proyecto">@resultado.Nombre</td>
                                        <td class="col-equipo">@resultado.Equipo</td>
                                        <td class="col-votos">@resultado.TotalVotos</td>
                                        <td class="col-manual">
                                            <span class="badge @(resultado.IsManual ? "badge-manual" : "badge-auto")">
                                                @(resultado.IsManual ? "Manual" : "Auto")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Panel Derecho: Formulario de Asignación -->
                <div class="ranking-panel asignacion-manual">
                    <h3>Asignar resultado manualmente</h3>

                    @if (selectedProyectoId == null)
                    {
                        <div class="placeholder-text">
                            <p>👈 Selecciona un proyecto de la tabla para empezar</p>
                        </div>
                    }
                    else
                    {
                        <div class="proyecto-info">
                            <h4>@selectedProyectoNombre</h4>
                            <p class="equipo-info">@selectedProyectoEquipo</p>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="posicion">Posición final</label>
                                <input type="number" id="posicion" class="form-control" @bind="posicionFinal" min="1" />
                            </div>
                            <div class="form-group">
                                <label for="votos">Votos asignados</label>
                                <input type="number" id="votos" class="form-control" @bind="votosAsignados" min="0" />
                            </div>
                        </div>

                        <button class="btn-guardar" @onclick="GuardarAsignacion" disabled="@guardando">
                            @if (guardando)
                            {
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar asignación</span>
                            }
                        </button>

                        @if (!string.IsNullOrEmpty(mensajeExito))
                        {
                            <div class="alert alert-success">
                                ✓ @mensajeExito
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-error">
                                ✗ @mensajeError
                            </div>
                        }

                        <!-- Panel de Justificaciones -->
                        <div class="justificaciones-panel">
                            <h4>Justificación <span class="label-optional">(Comentario)</span></h4>

                            @if (justificacionActual != null)
                            {
                                <div class="comentario-existente">
                                    <div class="comentario-header">
                                        <span class="comentario-usuario">@justificacionActual.UsuarioNombre</span>
                                        <span class="comentario-rol">@justificacionActual.RolUsuario</span>
                                        <span class="comentario-fecha">@justificacionActual.FechaJustificacion.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div class="comentario-texto">
                                        @justificacionActual.TextoJustificacion
                                    </div>
                                    <p class="comentario-nota">Este comentario será reemplazado si agregas uno nuevo</p>
                                </div>
                            }

                            <textarea id="justificacion" class="form-control" @bind="textoJustificacion" placeholder="Escribe la justificación de esta asignación manual..." />

                            <button class="btn-guardar-justificacion" @onclick="GuardarJustificacion" disabled="@(string.IsNullOrEmpty(textoJustificacion?.Trim()) || guardandoJustificacion)">
                                @if (guardandoJustificacion)
                                {
                                    <span>Guardando comentario...</span>
                                }
                                else
                                {
                                    <span>Guardar comentario</span>
                                }
                            </button>

                            @if (!string.IsNullOrEmpty(mensajeJustificacion))
                            {
                                <div class="alert alert-success" style="margin-top: 0.5rem;">
                                    ✓ @mensajeJustificacion
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .main-container {
        background-color: #f4f4f8;
        min-height: 100vh;
        padding: 1.5rem;
        font-family: 'Inter', sans-serif;
    }

    .header-principal {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        max-width: 1400px;
        margin: 0 auto 1.25rem;
    }

    .btn-volver {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        background: white;
        border: 1px solid #e2e8f0;
        color: #64748b;
