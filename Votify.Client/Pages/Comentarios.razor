@code {
    [Parameter] public string? VotacionId { get; set; }
    [Parameter] public string? ProyectoId { get; set; }

    private bool cargando = true;
    private string? errorCarga;
    private bool generandoResumen;
    private string? errorResumen;
    private ProyectoDto? proyecto;
    private VotacionDto? votacion;
    private List<ComentarioDto> comentarios = new();
    private ResultadoMulticriterioDto? resultadoMulticriterio;
    private bool scoreRevelado;
    private ResumenComentarioDto? resumen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            errorCarga = null;
            if (!string.IsNullOrEmpty(VotacionId))
            {
                votacion = await VotacionesService.ObtenerVotacion(VotacionId);
            }

            if (!string.IsNullOrEmpty(ProyectoId))
            {
                proyecto = await ProyectosService.ObtenerProyectoAsync(ProyectoId);
                comentarios = await ProyectosService.ObtenerComentariosAsync(ProyectoId, VotacionId);
            }

            if (EsMulticriterio && !string.IsNullOrEmpty(VotacionId) && !string.IsNullOrEmpty(ProyectoId))
            {
                var resultados = await VotacionesService.ObtenerResultadosMulticriterio(VotacionId);
                resultadoMulticriterio = resultados?.FirstOrDefault(r => r.Id == ProyectoId);
            }
        }
        catch (Exception ex)
        {
            errorCarga = ex.Message;
            Console.WriteLine($"Error cargando comentarios: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver() => Nav.NavigateTo($"/{VotacionId}/proyectos/{ProyectoId}");

    private void RevelarNota()
    {
        scoreRevelado = true;
    }

    private string MensajePuntuacion
    {
        get
        {
            var equipo = resultadoMulticriterio?.Equipo ?? "Equipo";
            if (!scoreRevelado)
                return $"¡Tienes un regalo, {equipo}!";
            var nota = resultadoMulticriterio?.PuntajeFinal ?? 0;
            return nota switch
            {
                >= 4.5 => $"¡Excelente, {equipo}! 🏆",
                >= 3.5 => $"¡Gran Trabajo, {equipo}! 🎉",
                >= 2.5 => $"¡Buen Trabajo, {equipo}! 💪",
                _ => $"¡Ánimo, {equipo}! 🚀"
            };
        }
    }

    private bool EsVotacionAnonima => votacion?.EsAnonima ?? false;
    private bool EsMulticriterio => votacion?.Tipo?.Equals("MULTICRITERIO", StringComparison.OrdinalIgnoreCase) ?? false;
    private List<CriterioDto> criterios => votacion?.Criterios ?? new();

    private string GetAutorEtiqueta(ComentarioDto comentario, int index)
    {
        if (EsVotacionAnonima || comentario.EsAnonimo)
        {
            return "Anónimo";
        }

        if (!string.IsNullOrEmpty(comentario.AutorNombre))
        {
            return comentario.AutorNombre;
        }

        if (comentario.AutorId.HasValue)
        {
            var shortId = comentario.AutorId.Value.ToString().Split('-')[0];
            return $"Votante {shortId}";
        }

        return "Anónimo";
    }

    private string GetAvatarLabel(ComentarioDto comentario, int index) => (EsVotacionAnonima || comentario.EsAnonimo) ? $"A{index + 1}" : "V";

    private async Task GenerarResumen()
    {
        if (string.IsNullOrEmpty(ProyectoId)) return;
        generandoResumen = true;
        errorResumen = null;
        try
        {
            resumen = await ProyectosService.ObtenerResumenAsync(ProyectoId);
        }
        catch (Exception ex)
        {
            errorResumen = "No se pudo generar el resumen. Intenta de nuevo.";
            Console.WriteLine($"Error generando resumen: {ex.Message}");
        }
        finally
        {
            generandoResumen = false;
        }
    }
}
