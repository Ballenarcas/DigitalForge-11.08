@page "/{VotacionId}/proyectos/{ProyectoId}/comentarios"
@using Votify.Client.DTOs
@using Votify.Client.Services
@inject ProyectosService ProyectosService
@inject VotacionesService VotacionesService
@inject NavigationManager Nav

<div class="comments-wrapper">
    @if (cargando)
    {
        <div class="loader-center">
            <div class="spinner"></div>
            <p>Cargando comentarios...</p>
        </div>
    }
    else
    {
        <div class="comments-header">
            <button class="btn-volver" @onclick="Volver">← Volver</button>
            <div class="comments-title-group">
                <p class="section-label">Evento</p>
                <h1 class="comments-title">Comentarios de feedback</h1>
                <p class="comments-subtitle">Proyecto: <strong>@proyecto?.Nombre</strong></p>
            </div>
        </div>

        <div class="comments-card">
            @if (!string.IsNullOrWhiteSpace(errorCarga))
            {
                <div class="access-error-state">
                    <strong>No se pudieron cargar los comentarios.</strong>
                    <p>@errorCarga</p>
                </div>
            }
            else if (comentarios.Count == 0)
            {
                <div class="empty-state">
                    <p>No hay comentarios para este proyecto aún.</p>
                </div>
            }
            else
            {
                <div class="comments-count">@comentarios.Count comentario(s)</div>
                <div class="comments-list">
                    @for (var index = 0; index < comentarios.Count; index++)
                    {
                        var comentario = comentarios[index];
                        <div class="comment-item">
                            <div class="comment-avatar">@GetAvatarLabel(comentario, index)</div>
                            <div class="comment-content">
                                <div class="comment-meta">@GetAutorEtiqueta(comentario, index)</div>
                                <div class="comment-date">@comentario.FechaCreacion.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                                <p class="comment-text">“@comentario.Texto”</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .comments-wrapper {
        min-height: 100vh;
        background: #f8f9fc;
        font-family: 'Inter', sans-serif;
        padding: 1.5rem;
    }
    .comments-header {
        max-width: 1100px;
        margin: 0 auto 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .btn-volver {
        width: fit-content;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.7rem 1rem;
        color: #475569;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s;
    }
    .btn-volver:hover { background: #f8f9fc; border-color: #ddd6fe; }
    .comments-title-group { max-width: 840px; }
    .section-label {
        margin: 0 0 0.4rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #7c3aed;
        font-size: 0.8rem;
        font-weight: 800;
    }
    .comments-title {
        margin: 0;
        font-size: 2.25rem;
        font-weight: 900;
        color: #111827;
    }
    .comments-subtitle {
        margin: 0.75rem 0 0 0;
        color: #475569;
        font-size: 0.95rem;
    }
    .comments-card {
        max-width: 1100px;
        margin: 0 auto;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 28px;
        padding: 1.75rem;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
    }
    .comments-count {
        color: #6b7280;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }
    .comments-list {
        display: grid;
        gap: 1rem;
    }
    .comment-item {
        display: flex;
        gap: 1rem;
        padding: 1.2rem 1.25rem;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        background: #f8fafc;
    }
    .comment-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #d8b4fe;
        color: white;
        display: grid;
        place-items: center;
        font-weight: 800;
    }
    .comment-content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .comment-meta {
        color: #7c3aed;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .comment-date {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 600;
        margin-top: -0.15rem;
        margin-bottom: 0.45rem;
    }
    .comment-text {
        margin: 0;
        color: #334155;
        line-height: 1.75;
        font-size: 0.95rem;
    }
    .loader-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 6rem 0;
        color: #64748b;
    }
    .spinner {
        width: 36px;
        height: 36px;
        border: 4px solid #ede9fe;
        border-top: 4px solid #7c3aed;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
        margin-bottom: 1rem;
    }
    .empty-state {
        padding: 3rem;
        text-align: center;
        color: #475569;
        font-weight: 600;
        background: #f8fafc;
        border: 1px dashed #e5e7eb;
        border-radius: 20px;
    }
    .access-error-state {
        padding: 1.25rem 1.5rem;
        border-radius: 18px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }
    .access-error-state strong {
        display: block;
        margin-bottom: 0.35rem;
    }
    .access-error-state p {
        margin: 0;
        line-height: 1.6;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    @@media (max-width: 900px) {
        .comments-wrapper { padding: 1rem; }
        .comments-header { gap: 0.75rem; }
        .comments-card { padding: 1.25rem; }
    }
</style>

@code {
    [Parameter] public string? VotacionId { get; set; }
    [Parameter] public string? ProyectoId { get; set; }

    private bool cargando = true;
    private string? errorCarga;
    private ProyectoDto? proyecto;
    private VotacionDto? votacion;
    private List<ComentarioDto> comentarios = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            errorCarga = null;
                if (!string.IsNullOrEmpty(VotacionId))
            {
                votacion = await VotacionesService.ObtenerVotacion(VotacionId);
            }

            if (!string.IsNullOrEmpty(ProyectoId))
            {
                proyecto = await ProyectosService.ObtenerProyectoAsync(ProyectoId);
                comentarios = await ProyectosService.ObtenerComentariosAsync(ProyectoId, VotacionId);
            }
        }
        catch (Exception ex)
        {
            errorCarga = ex.Message;
            Console.WriteLine($"Error cargando comentarios: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver() => Nav.NavigateTo($"/{VotacionId}/proyectos/{ProyectoId}");

    private bool EsVotacionAnonima => votacion?.Tipo?.Equals("ANONIMA", StringComparison.OrdinalIgnoreCase) ?? false;

    private string GetAutorEtiqueta(ComentarioDto comentario, int index)
    {
        if (EsVotacionAnonima || comentario.EsAnonimo)
        {
            return "Anónimo";
        }

        if (!string.IsNullOrEmpty(comentario.AutorNombre))
        {
            return comentario.AutorNombre;
        }

        if (comentario.AutorId.HasValue)
        {
            var shortId = comentario.AutorId.Value.ToString().Split('-')[0];
            return $"Votante {shortId}";
        }

        return "Anónimo";
    }

    private string GetAvatarLabel(ComentarioDto comentario, int index) => (EsVotacionAnonima || comentario.EsAnonimo) ? $"A{index + 1}" : "V";
}
